desc:Ableton Vocoder
// Ableton Live-style channel vocoder.
// @gfx is the device panel. It may read 0..79 and the slider variables,
// and it may write BAND_ATT. Do not move the offsets below.

// ---------------------------------------------------------------------------
// Memory map (EEL2 heap indices)
//
//   0 .. 39   BAND_ATT   per-band attenuation in dB. 0 = none.
//                        Clamped to [-60, 0]. Persisted by @serialize
//                        (version word via file_var, then file_mem of these
//                        40 values). Future versions must bump SER_VER.
//  40 .. 79   DISP_ENV   per-band display level: smoothed modulator envelope
//                        in linear amplitude (band RMS), AFTER attenuation
//                        (env_rms * 10^(att_dB/20)).
//                        Mono / Stereo: the mono analysis envelope.
//                        L/R: max(left, right). Not persisted.
//
// DSP workspace starts at 128. GUI code should only touch 0..79.
// ---------------------------------------------------------------------------

slider1:s_carrier=0<0,3,1{Noise,External,Modulator,Pitch Tracking}>Carrier
slider2:s_bands=4<0,9,1{4,8,12,16,20,24,28,32,36,40}>Bands
slider3:s_low=80<20,2000,1>Range Low (Hz)
slider4:s_high=18000<1000,20000,1>Range High (Hz)
slider5:s_bw=100<10,200,1>BW (%)
slider6:s_fmode=0<0,1,1{Precise,Retro}>Filter Mode
slider7:s_gate=-96<-96,0,1>Gate (dB)
slider8:s_level=0<-24,24,0.1>Level (dB)
slider9:s_depth=100<0,200,1>Depth (%)
slider10:s_attack=5<0.1,100,0.1>Attack (ms)
slider11:s_release=80<1,1000,1>Release (ms)
slider12:s_formant=0<-12,12,0.1>Formant (st)
slider13:s_drywet=100<0,100,1>Dry/Wet (%)
slider14:s_channels=1<0,2,1{Mono,Stereo,L/R}>Channels
slider15:s_enhance=0<0,1,1>Enhance
slider16:s_unvoiced=-96<-96,0,1>Unvoiced (dB)
slider17:s_sens=50<0,100,1>Sens (%)
slider18:s_uvspeed=0<0,1,1{Slow,Fast}>Unvoiced Speed
slider19:s_nrate=1<0,1,0.01>Noise Rate
slider20:s_ncrack=1<0,1,0.01>Noise Crackle
slider21:s_wave=0<0,3,1{Saw,Pulse 50%,Pulse 25%,Pulse 12.5%}>Osc Wave
slider22:s_opitch=0<-24,24,1>Osc Pitch (st)
slider23:s_tlow=60<20,1000,1>Track Low (Hz)
slider24:s_thigh=1000<100,2000,1>Track High (Hz)
slider25:s_device=1<0,1,1>Device On

in_pin:Modulator L
in_pin:Modulator R
in_pin:Carrier L (sidechain)
in_pin:Carrier R (sidechain)
out_pin:Output L
out_pin:Output R

@init
SER_VER = 1;
MAXB = 40;
BAND_ATT = 0;
DISP_ENV = 40;

// Per-band coefficient record. Stride 24, base COEF.
//  0 log_fc smoothed (natural log Hz)
//  1 log_fc target
//  2 Q smoothed
//  3 Q target
//  4 retro gain smoothed (linear)
//  5 retro gain target
//  6 flat makeup smoothed (linear, includes alternating-sum normalization)
//  7 flat makeup target
//  8 inv sqrt(noise power gain)   so env_rms * this ~= white-equivalent RMS
//  9 sign (+1 / -1), alternating across the bank
// 10 attenuation smoothed (linear)
// 11 attenuation target (linear)
// 12 a1 13 a2 14 a3 15 k     analysis SVF
// 16 sa1 17 sa2 18 sa3 19 sk synthesis SVF
// 20 band mix 0..1
// 21 center Hz (analysis, smoothed)
COEF = 128;
CSTR = 24;

// Filter state. 4 lanes x MAXB. Stride 8.
// lane 0 analysis L (also mono / stereo modulator)
// lane 1 analysis R (L/R mode)
// lane 2 synthesis L (also mono)
// lane 3 synthesis R
//  0 ic1a 1 ic2a 2 ic1b 3 ic2b
//  4 amplitude envelope (RMS). Attack/Release one-pole is on this, not on power.
//  5 gate gain
//  6 gate open (0/1)
//  7 enhance power (synthesis lanes)
STATE = COEF + MAXB * CSTR;
SSTR = 8;
LANE_AL = 0;
LANE_AR = MAXB;
LANE_SL = MAXB * 2;
LANE_SR = MAXB * 3;
LANE_STEP = MAXB * SSTR;

// Pitch ring (power of two) and YIN scratch. Above the DSP records.
RING = 8192;
RING_SIZE = 4096;
RING_MASK = 4095;
YBUF = RING + RING_SIZE;          // 12288, length 4096
YIN_D = YBUF + 4096;              // 16384, length 4096
// Solver scratch. EEL2 names are case-insensitive: never declare a local
// hr/hi (or garr, smag, ...) in a function that also touches these bases.
GARR = 22000;
SMAG = 22100;                     // up to 48 mags
SR_A = 22200;
SI_A = 22300;
HR = 24000;                       // nfreq * MAXB
HI = 24000 + 48 * MAXB;

PI = 3.141592653589793;
LN2 = 0.6931471805599453;
LN10 = 2.302585092994046;
DB2A = LN10 / 20;
Q_DEN = sqrt(1 + sqrt(2));        // 4th-order -3 dB Q factor
INV_SQRT2 = 0.7071067811865476;

// Depth / envelope → band gain.
// env is the band amplitude after the attack/release one-pole (not power).
// No envelope floor and no minimum gain: env → 0 forces gain → 0 at every
// Depth other than 0%. Depth 0% ignores the envelope and uses gain 1.
//
// Enhance off:
//   r = env * inv_sqrt(vr) / REF_LIN
//   Depth 100% uses r. Other depths use r ^ (Depth/100).
//   inv_sqrt(vr) is the band's white-noise power gain, so r = 1 (unity)
//   for a white modulator at REF_LIN = -18 dBFS. A harmonic carrier is
//   louder than noise under this law, because a partial fills a narrow
//   band. TRIM_* below is one constant broadband gain per carrier mode
//   that removes that bias. It is not per-band and it does not move with
//   the envelope, so formants, a saw's tilt, and the release tail stay.
//
// Enhance on:
//   the carrier band is divided by its own amplitude, then scaled by the
//   analysis envelope. At Depth 100% the NOMINALs cancel and the band
//   output tracks env.
//   The divisor may sit up to 60 dB below this sample's loudest carrier
//   band, and never below -100 dBFS. Quieter than that, the band gain
//   fades to 0 across a 12 dB knee (smoothstep on the log level) so a
//   noise floor is not boosted and the gain has no step. There is no
//   fixed 32x cap on content inside the window. The carrier-level
//   smoother attacks in 4 ms and releases in 15 ms.
//   GAIN_CAP = 32 bounds env/NOMINAL. It binds only when one band's
//   amplitude envelope exceeds 1.6 (+4.1 dBFS). On ordinary material,
//   including the -18 dBFS synth voice, it does not trigger. It is a
//   safety clamp, not part of the Enhance curve.
//   Enhance off and on are crossfaded. They are not stacked.
//   The TRIM_* gain is not applied while Enhance is on.
DENS_EXP = 1;
REF_LIN = exp(-18 * DB2A);
INV_REF_DENS = 1 / REF_LIN;
NOMINAL = 0.05;
INV_REF_ENH = 1 / NOMINAL;
GAIN_CAP = 32;
ENH_REL = exp(-60 * DB2A);
ENH_ABS = exp(-100 * DB2A);
ENH_KNEE = exp(12 * DB2A);
ENH_KNEE_LOG = 12 * DB2A;
// Enhance-off broadband trims. Measured with a -18 dBFS speech modulator,
// 20 bands, Precise, Depth 100%, Enhance off, so the output lands on the
// input: noise at default Rate/Crackle, a -18 dBFS saw chord, the speech
// used as its own carrier, and the pitch-tracking saw. Linear density
// already tracks the envelope, so these stay constant.
TRIM_NOISE = 0.6831955045222029;
TRIM_EXT = 0.11665812717409325;
TRIM_MOD = 0.05570895346700124;
TRIM_PITCH = 0.07670081876935099;

// Internal carriers (noise and the pitch oscillator), full-band RMS.
// -18 dBFS. Uniform[-1,1] and the raw bipolar saw both have RMS 1/sqrt(3).
WHITE_RMS = 0.12589254117941673;
NOISE_AMP = 0.21805227761670687;
SAW_SCALE = 0.21805227761670687;
P50_SCALE = 0.12589254117941673;
P25_SCALE = 0.14536818507780461;
P125_SCALE = 0.19033163193068273;

memset(0, 0, HI + 48 * MAXB);

pt_target = 100;
pt_log = log(100);
pt_have = 0;
osc_phase = 0;
boot = 1;
active_carrier = -1;
active_ch = -1;
duck = 1;
duck_target = 1;
design_sig = -1;
uv_env = 0;
formant_sm = 0;
enh_mix = 0;
enh_peak = 0;
enh_seen = 0;
lvl = 1;
wet = 1;
dev = 1;
n_bands = 20;
n_run = 20;
ring_w = 0;
ring_fill = 0;
hop_count = 0;
dec_i = 0;

function polyblep(t, dt) (
  t < dt ? (
    t /= dt;
    t + t - t * t - 1;
  ) : (
    t > 1 - dt ? (
      t = (t - 1) / dt;
      t * t + t + t + 1;
    ) : 0;
  );
);

function q_of(fc, bw_oct) local(r, fe, oc, oe, qq) global(srate, PI, LN2, Q_DEN) (
  r = exp(bw_oct * 0.5 * LN2);
  fe = fc * r;
  fe > srate * 0.49 ? fe = srate * 0.49;
  oc = tan(PI * fc / srate);
  oe = tan(PI * fe / srate);
  oc < 0.000000000001 ? oc = 0.000000000001;
  r = oe / oc;
  qq = r / (abs(1 - r * r) * Q_DEN + 0.000000000001);
  qq < 0.12 ? qq = 0.12;
  qq > 64 ? qq = 64;
  qq;
);

// Noise power gain of one unity-peak 4th-order band, matched to the quadrature
// envelope (not raw bp variance). Narrow bands: vr = g / (2 Q (1+g^2)), and the
// second-stage lowpass is a true Hilbert partner so the envelope equals RMS.
// Wide / high bands: the lowpass is heavier than the bandpass, so the envelope
// reads hot. Integrate (|Hbp|^4 + |Hbp|^2 |k Lp|^2) / 2, which is what
// sqrt(smoothed(bp^2+(k*lp)^2)/2) reports for white noise.
function h4_det(freq, fc, qq) local(g, k, w, den, num) global(srate, PI) (
  g = tan(PI * fc / srate);
  g < 0.000000000001 ? g = 0.000000000001;
  k = 1 / qq;
  w = tan(PI * min(freq, srate * 0.499) / srate) / g;
  den = (1 - w * w);
  den = den * den + (k * w) * (k * w);
  den < 0.000000000000000001 ? den = 0.000000000000000001;
  num = k * k * w;
  num = num * num * (1 + w * w) / (2 * den * den);
  num;
);

function band_vr(fc, qq) local(g, vr, n, i, f1, f2, f, p, prev_f, prev_p, step) global(srate, PI) (
  g = tan(PI * min(fc, srate * 0.45) / srate);
  vr = g / (2 * qq * (1 + g * g));
  (qq >= 1.2 && fc < srate * 0.12) ? vr : (
    n = 72;
    f1 = max(fc / 32, 1);
    f2 = min(fc * 32, srate * 0.49);
    f2 <= f1 ? vr : (
      step = log(f2 / f1) / (n - 1);
      prev_f = f1;
      prev_p = h4_det(f1, fc, qq);
      vr = 0;
      i = 1;
      loop(n - 1,
        f = f1 * exp(step * i);
        p = h4_det(f, fc, qq);
        vr += (prev_p + p) * 0.5 * (f - prev_f);
        prev_f = f;
        prev_p = p;
        i += 1;
      );
      vr = 2 * vr / srate;
      vr < 0.0000000001 ? 0.0000000001 : vr;
    );
  );
);

function svf_set(fc, qq) local(g, kk) global(o_a1, o_a2, o_a3, o_k, srate, PI) (
  fc < 1 ? fc = 1;
  fc > srate * 0.45 ? fc = srate * 0.45;
  qq < 0.12 ? qq = 0.12;
  g = tan(PI * fc / srate);
  kk = 1 / qq;
  o_a1 = 1 / (1 + g * (g + kk));
  o_a2 = g * o_a1;
  o_a3 = g * o_a2;
  o_k = kk;
);

function bp4_ri(freq, fc, qq) local(g, k, w, dr, di, ni, den, pr, pj)
global(h_re, h_im, srate, PI) (
  g = tan(PI * min(fc, srate * 0.45) / srate);
  g < 0.000000000001 ? g = 0.000000000001;
  k = 1 / max(qq, 0.12);
  w = tan(PI * min(freq, srate * 0.499) / srate) / g;
  dr = 1 - w * w;
  di = k * w;
  ni = k * w;
  den = dr * dr + di * di;
  den < 0.000000000000000001 ? den = 0.000000000000000001;
  pr = (ni * di) / den;
  pj = (ni * dr) / den;
  h_re = pr * pr - pj * pj;
  h_im = 2 * pr * pj;
);

function median_buf(buf, n) local(i, j, key) (
  i = 1;
  loop(max(n - 1, 0),
    key = buf[i];
    j = i - 1;
    while (j >= 0 && buf[j] > key) (
      buf[j + 1] = buf[j];
      j -= 1;
    );
    buf[j + 1] = key;
    i += 1;
  );
  n < 2 ? buf[0] : ((buf[n / 2 - 1] + buf[n / 2]) * 0.5);
);

// Alternating-polarity makeup so |sum sign_i * g_i * H_i| ~= 1 across the bank.
function solve_flat() local(nfreq, fmin, fmax, log0, log1, fi, bi, freq, idx, sgn, acc_r, acc_i, mag, med, tr, ti, num, den, gn, xr, xi, cf) global(srate, flo, fhi, n_bands, COEF, CSTR, MAXB, HR, HI, GARR, SMAG, SR_A, SI_A, h_re, h_im) (
  nfreq = 36;
  fmin = flo * 1.25;
  fmax = fhi * 0.8;
  fmax > srate * 0.45 ? fmax = srate * 0.45;
  (n_bands < 2 || fmax <= fmin * 1.02) ? (
    bi = 0;
    loop(n_bands,
      (COEF + bi * CSTR)[7] = 1;
      bi += 1;
    );
  ) : (
    log0 = log(fmin);
    log1 = log(fmax);
    fi = 0;
    loop(nfreq,
      freq = exp(log0 + (log1 - log0) * fi / (nfreq - 1));
      bi = 0;
      loop(n_bands,
        cf = COEF + bi * CSTR;
        bp4_ri(freq, exp(cf[1]), cf[3]);
        sgn = cf[9];
        idx = fi * MAXB + bi;
        HR[idx] = h_re * sgn;
        HI[idx] = h_im * sgn;
        bi += 1;
      );
      fi += 1;
    );
    bi = 0;
    loop(n_bands, GARR[bi] = 1; bi += 1;);
    loop(4,
      fi = 0;
      loop(nfreq,
        acc_r = 0;
        acc_i = 0;
        bi = 0;
        loop(n_bands,
          idx = fi * MAXB + bi;
          acc_r += HR[idx] * GARR[bi];
          acc_i += HI[idx] * GARR[bi];
          bi += 1;
        );
        SR_A[fi] = acc_r;
        SI_A[fi] = acc_i;
        SMAG[fi] = sqrt(acc_r * acc_r + acc_i * acc_i) + 0.000000000001;
        fi += 1;
      );
      med = median_buf(SMAG, nfreq);
      bi = 0;
      loop(n_bands,
        num = 0;
        den = 0;
        fi = 0;
        loop(nfreq,
          idx = fi * MAXB + bi;
          xr = HR[idx];
          xi = HI[idx];
          mag = sqrt(SR_A[fi] * SR_A[fi] + SI_A[fi] * SI_A[fi]) + 0.000000000001;
          tr = med * SR_A[fi] / mag - SR_A[fi] + GARR[bi] * xr;
          ti = med * SI_A[fi] / mag - SI_A[fi] + GARR[bi] * xi;
          num += xr * tr + xi * ti;
          den += xr * xr + xi * xi;
          fi += 1;
        );
        den < 0.0000000001 ? den = 0.0000000001;
        gn = num / den;
        gn = 0.55 * GARR[bi] + 0.45 * gn;
        gn < 0.2 ? gn = 0.2;
        gn > 5 ? gn = 5;
        GARR[bi] = gn;
        bi += 1;
      );
    );
    fi = 0;
    loop(nfreq,
      acc_r = 0;
      acc_i = 0;
      bi = 0;
      loop(n_bands,
        idx = fi * MAXB + bi;
        acc_r += HR[idx] * GARR[bi];
        acc_i += HI[idx] * GARR[bi];
        bi += 1;
      );
      SMAG[fi] = sqrt(acc_r * acc_r + acc_i * acc_i) + 0.000000000001;
      fi += 1;
    );
    med = median_buf(SMAG, nfreq);
    med < 0.0001 ? med = 1;
    bi = 0;
    loop(n_bands,
      (COEF + bi * CSTR)[7] = GARR[bi] / med;
      bi += 1;
    );
  );
);

function design_targets() local(bi, cf, t, span, fc, qq, qm, vr, bw_oct) global(srate, flo, fhi, n_bands, bw_pct, retro_on, COEF, CSTR, MAXB, LN2, DB2A, DENS_EXP) (
  flo < 20 ? flo = 20;
  fhi > srate * 0.45 ? fhi = srate * 0.45;
  fhi < flo * 1.25 ? fhi = min(flo * 1.25, srate * 0.45);
  fhi <= flo ? fhi = min(flo * 2, srate * 0.45);
  span = log(fhi / flo);
  n_bands > 1 ? (bw_oct = (span / LN2) / (n_bands - 1) * (bw_pct / 100);) : (bw_oct = 1;);
  bw_oct < 0.02 ? bw_oct = 0.02;
  bi = 0;
  loop(MAXB,
    cf = COEF + bi * CSTR;
    bi < n_bands ? (
      n_bands > 1 ? t = bi / (n_bands - 1) : t = 0;
      fc = exp(log(flo) + span * (n_bands > 1 ? bi / (n_bands - 1) : 0.5));
      fc > srate * 0.45 ? fc = srate * 0.45;
      qq = q_of(fc, bw_oct);
      retro_on ? (
        qm = 1 + t * 1.5;
        qq *= qm;
        qq > 64 ? qq = 64;
        cf[5] = exp(t * 6 * DB2A);
      ) : (
        cf[5] = 1;
      );
      cf[1] = log(fc);
      cf[3] = qq;
      cf[9] = (bi % 2) ? -1 : 1;
      vr = band_vr(fc, qq);
      vr < 0.0000000001 ? vr = 0.0000000001;
      // DENS_EXP = 1 maps band RMS to white-equivalent level (flat on white).
      // Lower values reduce the boost on narrow bands, which is where a saw
      // or a vowel piles up. 1 is the flat-white calibration.
      cf[8] = exp(DENS_EXP * log(1 / sqrt(vr)));
      cf[21] = fc;
    ) : (
      cf[1] = log(max(flo, 20));
      cf[3] = 1;
      cf[5] = 1;
      cf[7] = 0;
      cf[8] = 1;
      cf[9] = 1;
      cf[21] = flo;
    );
    bi += 1;
  );
  solve_flat();
);

function smooth_coeffs() local(bi, cf, a, fc, fcs, qq, amix, form_ratio) global(o_a1, o_a2, o_a3, o_k, srate, samplesblock, boot, formant_sm, s_formant, LN2, COEF, CSTR, MAXB, n_bands) (
  a = 1 - exp(-samplesblock / (0.02 * srate));
  a > 1 ? a = 1;
  boot ? formant_sm = s_formant : (
    formant_sm += (1 - exp(-samplesblock / (0.012 * srate))) * (s_formant - formant_sm);
  );
  form_ratio = exp(formant_sm * LN2 / 12);
  bi = 0;
  loop(MAXB,
    cf = COEF + bi * CSTR;
    boot ? (
      cf[0] = cf[1];
      cf[2] = cf[3];
      cf[4] = cf[5];
      cf[6] = cf[7];
      amix = bi < n_bands ? 1 : 0;
      cf[20] = amix;
    ) : (
      cf[0] += a * (cf[1] - cf[0]);
      cf[2] += a * (cf[3] - cf[2]);
      cf[4] += a * (cf[5] - cf[4]);
      cf[6] += a * (cf[7] - cf[6]);
    );
    fc = exp(cf[0]);
    qq = cf[2];
    qq < 0.12 ? qq = 0.12;
    svf_set(fc, qq);
    cf[12] = o_a1; cf[13] = o_a2; cf[14] = o_a3; cf[15] = o_k;
    fcs = fc * form_ratio;
    fcs > srate * 0.45 ? fcs = srate * 0.45;
    fcs < 1 ? fcs = 1;
    // Formant only slides the carrier centres. Q stays the analysis Q.
    svf_set(fcs, qq);
    cf[16] = o_a1; cf[17] = o_a2; cf[18] = o_a3; cf[19] = o_k;
    cf[21] = fc;
    bi < n_bands ? 0 : 0;
    bi += 1;
  );
);

// Two cascaded unity-peak TPT bandpasses. Coeffs are c_a1..c_k.
// Returns stage-2 bandpass. Sets env_a2 = bp^2 + (k*lp)^2 (peak^2 at fc).
function svf2(st, x) local(ic1, ic2, v3, v1, v2, bp)
global(c_a1, c_a2, c_a3, c_k, env_a2) (
  ic1 = st[0];
  ic2 = st[1];
  v3 = x - ic2;
  v1 = c_a1 * ic1 + c_a2 * v3;
  v2 = ic2 + c_a2 * ic1 + c_a3 * v3;
  st[0] = v1 + v1 - ic1;
  st[1] = v2 + v2 - ic2;
  bp = c_k * v1;
  ic1 = st[2];
  ic2 = st[3];
  v3 = bp - ic2;
  v1 = c_a1 * ic1 + c_a2 * v3;
  v2 = ic2 + c_a2 * ic1 + c_a3 * v3;
  st[2] = v1 + v1 - ic1;
  st[3] = v2 + v2 - ic2;
  bp = c_k * v1;
  env_a2 = bp * bp + (c_k * v2) * (c_k * v2);
  bp;
);

function env_follow(st, a2) local(ep, amp) global(att_c, rel_c) (
  amp = a2 > 0 ? sqrt(a2 * 0.5) : 0;
  ep = st[4];
  amp > ep ? (ep += att_c * (amp - ep);) : (ep += rel_c * (amp - ep););
  ep < 0.000000000001 ? ep = 0;
  st[4] = ep;
  ep;
);

function gate_follow(st, env) local(op, gg) global(gate_off, gate_open_th, gate_close_th, gate_c) (
  gate_off ? (
    st[6] = 1;
    st[5] = 1;
    1;
  ) : (
    op = st[6];
    op > 0.5 ? (env < gate_close_th ? op = 0;) : (env >= gate_open_th ? op = 1;);
    st[6] = op;
    gg = st[5];
    gg += gate_c * (op - gg);
    gg < 0.0000001 ? gg = 0;
    st[5] = gg;
    gg;
  );
);

function depth_gain(env, inv_vr) local(go, gn, b) global(depth_mode, INV_REF_DENS, INV_REF_ENH, depth_k, GAIN_CAP, enh_mix) (
  depth_mode == 0 ? (
    go = 1;
    gn = 1;
  ) : (
    env < 0.000000000001 ? (
      go = 0;
      gn = 0;
    ) : (
      b = env * inv_vr * INV_REF_DENS;
      go = exp(depth_k * log(b));
      b = env * INV_REF_ENH;
      gn = exp(depth_k * log(b));
    );
  );
  go > GAIN_CAP ? go = GAIN_CAP;
  gn > GAIN_CAP ? gn = GAIN_CAP;
  go < 0 ? go = 0;
  gn < 0 ? gn = 0;
  go * (1 - enh_mix) + gn * enh_mix;
);

function enh_boost(rms) local(flo, boost, hi, t, s)
global(enh_peak, enh_seen, ENH_REL, ENH_ABS, ENH_KNEE, ENH_KNEE_LOG, NOMINAL) (
  rms > enh_seen ? enh_seen = rms;
  flo = enh_peak * ENH_REL;
  flo < ENH_ABS ? flo = ENH_ABS;
  rms < flo ? (
    0;
  ) : (
    boost = NOMINAL / rms;
    hi = flo * ENH_KNEE;
    rms < hi ? (
      t = log(rms / flo) / ENH_KNEE_LOG;
      t < 0 ? t = 0;
      t > 1 ? t = 1;
      s = t * t * (3 - 2 * t);
      boost *= s;
    );
    boost;
  );
);

function synth_sample(st, x) local(y, yp, hp, rms, boost, hi, t, s) global(enh_mix, enh_att, enh_rel, NOMINAL, ENH_ABS, ENH_KNEE, ENH_KNEE_LOG) (
  y = svf2(st, x);
  enh_mix > 0.0005 ? (
    yp = y * y;
    hp = st[7];
    yp > hp ? (hp += enh_att * (yp - hp);) : (hp += enh_rel * (yp - hp););
    hp < 0.000000000000000000000001 ? hp = 0;
    st[7] = hp;
    rms = hp > 0 ? sqrt(hp) : 0;
    rms < ENH_ABS ? (
      boost = 0;
    ) : (
      boost = NOMINAL / rms;
      hi = ENH_ABS * ENH_KNEE;
      rms < hi ? (
        t = log(rms / ENH_ABS) / ENH_KNEE_LOG;
        t < 0 ? t = 0;
        t > 1 ? t = 1;
        s = t * t * (3 - 2 * t);
        boost *= s;
      );
    );
    y *= (1 - enh_mix + enh_mix * boost);
  );
  y;
);

function yin_run() local(frame, w, tau_min, tau_max, start, j, tau, xj, xt, s1, s2, rr, dd, acc, cm, best, bestv, found, a, b, c, denom, tau_f, f0, mean, energy, idx) global(sr_dec, tlow_hz, thigh_hz, ring_fill, ring_w, RING_SIZE, RING, YBUF, YIN_D, yin_gate2, pt_target, pt_have) (
  tau_max = floor(sr_dec / max(tlow_hz, 20));
  tau_max < 8 ? tau_max = 8;
  tau_max > 1500 ? tau_max = 1500;
  tau_min = floor(sr_dec / max(thigh_hz, tlow_hz + 1));
  tau_min < 2 ? tau_min = 2;
  tau_min >= tau_max - 2 ? tau_min = max(2, tau_max - 4);
  w = tau_max + 2;
  frame = w + w;
  ring_fill < frame ? 0 : (
    start = ring_w - frame;
    start < 0 ? start += RING_SIZE;
    mean = 0;
    j = 0;
    loop(frame,
      idx = start + j;
      idx >= RING_SIZE ? idx -= RING_SIZE;
      YBUF[j] = RING[idx];
      mean += YBUF[j];
      j += 1;
    );
    mean /= frame;
    energy = 0;
    j = 0;
    loop(frame,
      YBUF[j] -= mean;
      energy += YBUF[j] * YBUF[j];
      j += 1;
    );
    energy < yin_gate2 * frame ? 0 : (
      s1 = 0;
      j = 0;
      loop(w,
        s1 += YBUF[j] * YBUF[j];
        j += 1;
      );
      acc = 0;
      YIN_D[0] = 1;
      best = tau_min;
      bestv = 1000000000;
      found = 0;
      tau = 1;
      loop(tau_max,
        s2 = 0;
        rr = 0;
        j = 0;
        loop(w,
          xj = YBUF[j];
          xt = YBUF[j + tau];
          s2 += xt * xt;
          rr += xj * xt;
          j += 1;
        );
        dd = s1 + s2 - 2 * rr;
        dd < 0 ? dd = 0;
        acc += dd;
        cm = acc > 0 ? (dd * tau / acc) : 1;
        YIN_D[tau] = cm;
        tau >= tau_min && cm < bestv ? (
          bestv = cm;
          best = tau;
        );
        tau += 1;
      );
      // One extra lag so parabolic interpolation can look at tau+1.
      s2 = 0;
      rr = 0;
      j = 0;
      tau = tau_max + 1;
      loop(w,
        xj = YBUF[j];
        xt = YBUF[j + tau];
        s2 += xt * xt;
        rr += xj * xt;
        j += 1;
      );
      dd = s1 + s2 - 2 * rr;
      dd < 0 ? dd = 0;
      acc += dd;
      YIN_D[tau] = acc > 0 ? (dd * tau / acc) : 1;
      // Smallest lag under the threshold, then walk to the local minimum.
      tau = tau_min;
      found = 0;
      while (tau < tau_max && !found) (
        YIN_D[tau] < 0.15 ? found = 1 : (tau += 1;);
      );
      found ? (
        while (tau + 1 < tau_max && YIN_D[tau + 1] < YIN_D[tau]) (tau += 1;);
      ) : (
        bestv > 0.40 ? tau = 0 : tau = best;
      );
      tau > 1 ? (
        a = YIN_D[tau - 1];
        b = YIN_D[tau];
        c = YIN_D[tau + 1];
        denom = a - 2 * b + c;
        tau_f = denom != 0 ? (tau + 0.5 * (a - c) / denom) : tau;
        tau_f < 1 ? tau_f = tau;
        f0 = sr_dec / tau_f;
        f0 < tlow_hz ? f0 = tlow_hz;
        f0 > thigh_hz ? f0 = thigh_hz;
        pt_target = f0;
        pt_have = 1;
      );
    );
  );
);

// Mono modulator, Enhance off, Depth 100%, gate open, one carrier sample.
// cf[23] is inv_sqrt(vr)/REF_LIN. cf[22] is polarity * flatness * retro * n_trim.
// Band mix and atten still fade per sample, then snap once they arrive.
function fast_bands() local(bi, cf, fc_hz, b_a1, b_a2, b_a3, b_k, stA, stS, stT, p_ic1, p_ic2, p_v3, p_v1, p_v2, p_bp, p_a2, p_amp, p_ep, dgL, bm, at)
global(COEF, CSTR, STATE, SSTR, LANE_STEP, n_bands, att_c, rel_c, GAIN_CAP, modL, carL, sumL, sumR, DISP_ENV, e_all, e_hi, uv_off, bmix_c, att_sm_c)
(
  bi = 0;
  loop(n_bands,
    cf = COEF + bi * CSTR;
    bm = cf[20];
    abs(bm - 1) < 0.000001 ? bm = 1 : (
      bm += bmix_c * (1 - bm);
      cf[20] = bm;
    );
    at = cf[10];
    p_ep = cf[11];
    abs(at - p_ep) < 0.000001 ? at = p_ep : (
      at += att_sm_c * (p_ep - at);
      at < 0.000000000001 ? at = 0;
      cf[10] = at;
    );
    b_a1 = cf[12];
    b_a2 = cf[13];
    b_a3 = cf[14];
    b_k = cf[15];
    stA = STATE + bi * SSTR;
    p_ic1 = stA[0];
    p_ic2 = stA[1];
    p_v3 = modL - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stA[0] = p_v1 + p_v1 - p_ic1;
    stA[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stA[2];
    p_ic2 = stA[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stA[2] = p_v1 + p_v1 - p_ic1;
    stA[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_v3 = b_k * p_v2;
    p_a2 = p_bp * p_bp + p_v3 * p_v3;
    p_amp = p_a2 > 0 ? sqrt(p_a2 * 0.5) : 0;
    p_ep = stA[4];
    p_amp > p_ep ? (p_ep += att_c * (p_amp - p_ep);) : (p_ep += rel_c * (p_amp - p_ep););
    p_ep < 0.000000000001 ? p_ep = 0;
    stA[4] = p_ep;
    uv_off ? 0 : (
      e_all += p_a2;
      fc_hz = cf[21];
      fc_hz >= 4000 ? e_hi += p_a2;
    );
    DISP_ENV[bi] = p_ep * cf[11];
    dgL = p_ep * cf[23];
    dgL > GAIN_CAP ? dgL = GAIN_CAP;
    b_a1 = cf[16];
    b_a2 = cf[17];
    b_a3 = cf[18];
    b_k = cf[19];
    stS = stA + LANE_STEP * 2;
    p_ic1 = stS[0];
    p_ic2 = stS[1];
    p_v3 = carL - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stS[0] = p_v1 + p_v1 - p_ic1;
    stS[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stS[2];
    p_ic2 = stS[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stS[2] = p_v1 + p_v1 - p_ic1;
    stS[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    sumL += p_bp * dgL * cf[22] * at * bm;
    // Keep the unused right filter in step, so a little unvoiced noise can
    // wake it without a stale-state blast. Skipped when Unvoiced is off.
    uv_off ? 0 : (
      stT = stS + LANE_STEP;
      stT[0] = stS[0];
      stT[1] = stS[1];
      stT[2] = stS[2];
      stT[3] = stS[3];
      stT[7] = stS[7];
    );
    bi += 1;
  );
  sumR = sumL;
);

// GUI only. Asks the host for a hidpi framebuffer. The audio path never
// reads these; @init may clear them again when transport restarts.
gfx_ext_retina = 1;
gui_drag = 0;
gui_menu = 0;
gui_arm = 0;
gui_click_t = -1;
gui_click_id = 0;
gui_prev_cap = 0;
gui_prev_x = 0;
gui_prev_y = 0;
gui_a0 = 210 * PI / 180;
gui_asweep = 300 * PI / 180;

@slider
param_dirty = 1;

@block
n_tgt = (s_bands + 1) * 4;
n_tgt < 4 ? n_tgt = 4;
n_tgt > 40 ? n_tgt = 40;
bw_pct = s_bw;
bw_pct < 10 ? bw_pct = 10;
bw_pct > 200 ? bw_pct = 200;
flo = s_low;
fhi = s_high;
retro_on = s_fmode > 0.5;

sig = n_tgt * 100000 + floor(flo) + floor(fhi) * 0.001 + bw_pct * 17 + retro_on * 333 + floor(srate);
sig != design_sig ? (
  n_bands = n_tgt;
  design_targets();
  design_sig = sig;
  param_dirty = 1;
);

// Snap the smoothed design the first time through so tests are not a fade-in.
smooth_coeffs();
boot ? (
  lvl = exp(s_level * DB2A);
  wet = max(0, min(1, s_drywet * 0.01));
  dev = s_device > 0.5;
  enh_mix = s_enhance > 0.5;
  formant_sm = s_formant;
  active_carrier = s_carrier;
  active_ch = s_channels;
  duck = 1;
  duck_target = 1;
  pending_route = 0;
  gi = 0;
  loop(MAXB * 4,
    (STATE + gi * SSTR)[5] = 1;
    (STATE + gi * SSTR)[6] = 1;
    gi += 1;
  );
);

bi = 0;
loop(MAXB,
  cf = COEF + bi * CSTR;
  ad = BAND_ATT[bi];
  ad < -60 ? ad = -60;
  ad > 0 ? ad = 0;
  BAND_ATT[bi] = ad;
  cf[11] = exp(ad * DB2A);
  // Band atten starts at its target. A fade from silence here costs the
  // first pitch frames an octave error.
  boot ? cf[10] = cf[11];
  bi += 1;
);
boot = 0;

// Literal one-pole time constants on the amplitude envelope.
// Amplitude decays as exp(-t/tau), so 60 dB takes ln(1000)*tau ≈ 6.91*tau.
att_c = 1 - exp(-1 / (max(s_attack, 0.05) * 0.001 * srate));
rel_c = 1 - exp(-1 / (max(s_release, 0.2) * 0.001 * srate));
att_c > 1 ? att_c = 1;
rel_c > 1 ? rel_c = 1;
enh_att = 1 - exp(-1 / (0.004 * srate));
enh_rel = 1 - exp(-1 / (0.015 * srate));
enh_pk_att = 1 - exp(-1 / (0.001 * srate));
enh_pk_rel = 1 - exp(-1 / (0.200 * srate));
gate_c = 1 - exp(-1 / (0.004 * srate));
duck_c = 1 - exp(-1 / (0.0035 * srate));
macro_c = 1 - exp(-1 / (0.008 * srate));
bmix_c = 1 - exp(-1 / (0.012 * srate));
att_sm_c = 1 - exp(-1 / (0.008 * srate));
// Release is shorter than the attack, and short enough that a fricative
// does not leave noise in the next 20 ms frame once the modulator HF is gone.
uv_ms_a = s_uvspeed > 0.5 ? 0.004 : 0.012;
uv_ms_r = s_uvspeed > 0.5 ? 0.0025 : 0.0015;
uv_att = 1 - exp(-1 / (uv_ms_a * srate));
uv_rel = 1 - exp(-1 / (uv_ms_r * srate));
glide_c = 1 - exp(-1 / (0.0025 * srate));
lvl_target = exp(max(-24, min(24, s_level)) * DB2A);
wet_target = max(0, min(1, s_drywet * 0.01));
dev_target = s_device > 0.5;
enh_target = s_enhance > 0.5;

depth_sm = s_depth;
abs(s_depth - 100) < 0.01 ? depth_mode = 1 : (
  s_depth < 0.01 ? depth_mode = 0 : (
    depth_mode = 2;
    depth_k = s_depth * 0.01;
  );
);

gate_off = s_gate <= -95.5;
gate_open_th = exp(max(s_gate, -96) * DB2A);
gate_close_th = exp((max(s_gate, -96) - 3) * DB2A);

uv_off = (s_unvoiced <= -95.5 || s_sens <= 0);
uv_lin = uv_off ? 0 : exp(s_unvoiced * DB2A);
uv_thr = (100 - max(0, min(100, s_sens))) * 0.0084;
uv_energy_lin = exp(-46 * DB2A);

// Route changes duck the wet path, then swap, so the carrier discontinuity
// lands while the wet gain is ~0.
route_changed = (s_carrier != active_carrier || s_channels != active_ch);
route_changed ? (
  pending_route = 1;
  duck_target = 0;
) : (
  pending_route && duck < 0.02 ? (
    active_carrier = s_carrier;
    active_ch = s_channels;
    pending_route = 0;
    duck_target = 1;
  ) : (
    !pending_route ? duck_target = 1;
  );
);

// Noise sample-and-hold rate. 0 -> 300 Hz, 1 -> full rate, exponential.
nrate = max(0, min(1, s_nrate));
rate_hz = 300 * exp(nrate * log(srate / 300));
hold_n = srate / rate_hz;
hold_n < 1 ? hold_n = 1;

// Pitch decimator ~8-12 kHz, 4th-order lowpass, hop 4 ms.
decim = 2;
while ((srate / decim) > 12000) (decim += 1;);
sr_dec = srate / decim;
lp_fc = min(4200, 0.40 * sr_dec);
svf_set(lp_fc, 0.7071);
lp_a1 = o_a1; lp_a2 = o_a2; lp_a3 = o_a3; lp_k = o_k;
hop_n = floor(0.004 * sr_dec);
hop_n < 16 ? hop_n = 16;
tlow_hz = max(20, min(s_tlow, 1000));
thigh_hz = max(tlow_hz + 10, min(s_thigh, 2000));
yin_gate2 = exp(-50 * DB2A);
yin_gate2 *= yin_gate2;
pt_transpose = exp(max(-24, min(24, s_opitch)) * LN2 / 12);

n_run = n_bands;
bi = n_bands;
while (bi < MAXB && (COEF + bi * CSTR)[20] > 0.001) (bi += 1;);
n_run = bi;
// Fewer, wider bands of a harmonic carrier sum a bit quieter. -0.40 dB
// per octave of (N/20) keeps a saw-chord vocode inside 2 dB from 4 to 40
// bands. 20 bands is unity, so the TRIM_* levels are unchanged.
n_trim = exp(-0.40 * log(n_bands / 20) / LN2 * DB2A);
bi = 0;
loop(n_bands,
  cf = COEF + bi * CSTR;
  // Steady trim, and the white-equivalent envelope scale. Fast path only.
  cf[22] = cf[9] * cf[6] * cf[4] * n_trim;
  cf[23] = cf[8] * INV_REF_DENS;
  bi += 1;
);

@sample
duck += duck_c * (duck_target - duck);
lvl += macro_c * (lvl_target - lvl);
wet += macro_c * (wet_target - wet);
dev += macro_c * (dev_target - dev);
enh_mix += macro_c * (enh_target - enh_mix);
duck < 0 ? duck = 0;
duck > 1 ? duck = 1;

inL = spl0;
inR = spl1;

// Carrier.
active_carrier == 0 ? (
  sh_pos += 1;
  sh_pos >= hold_n ? (
    sh_pos -= hold_n;
    s_ncrack >= 0.999 ? (
      sh_l = (rand(2) - 1) * NOISE_AMP;
      sh_r = (rand(2) - 1) * NOISE_AMP;
    ) : (
      crack_p = s_ncrack * s_ncrack;
      crack_p = crack_p * crack_p;
      crack_p < 0.0008 ? crack_p = 0.0008;
      crack_a = WHITE_RMS / sqrt(crack_p);
      crack_a > 4 ? crack_a = 4;
      sh_l = rand(1) < crack_p ? (rand(1) < 0.5 ? crack_a : -crack_a) : 0;
      sh_r = rand(1) < crack_p ? (rand(1) < 0.5 ? crack_a : -crack_a) : 0;
    );
  );
  carL = sh_l;
  carR = sh_r;
) : active_carrier == 1 ? (
  carL = spl2;
  carR = spl3;
) : active_carrier == 2 ? (
  carL = inL;
  carR = inR;
) : (
  pt_log += glide_c * (log(max(pt_target, 1)) - pt_log);
  osc_dt = exp(pt_log) * pt_transpose / srate;
  osc_dt > 0.45 ? osc_dt = 0.45;
  osc_dt < 0 ? osc_dt = 0;
  osc_phase += osc_dt;
  osc_phase >= 1 ? osc_phase -= 1;
  s_wave < 0.5 ? (
    osc = (2 * osc_phase - 1) - polyblep(osc_phase, osc_dt);
    osc *= SAW_SCALE;
  ) : (
    s_wave < 1.5 ? pw = 0.5 : s_wave < 2.5 ? pw = 0.25 : pw = 0.125;
    osc = osc_phase < pw ? 1 : -1;
    osc += polyblep(osc_phase, osc_dt);
    ph2 = osc_phase + 1 - pw;
    ph2 >= 1 ? ph2 -= 1;
    osc -= polyblep(ph2, osc_dt);
    osc -= (pw + pw - 1);
    s_wave < 1.5 ? osc *= P50_SCALE : s_wave < 2.5 ? osc *= P25_SCALE : osc *= P125_SCALE;
  );
  carL = osc;
  carR = osc;
);

active_ch == 0 ? (
  carM = (carL + carR) * 0.5;
  carL = carM;
  carR = carM;
  modL = (inL + inR) * 0.5;
  modR = modL;
) : active_ch == 1 ? (
  modL = (inL + inR) * 0.5;
  modR = modL;
) : (
  modL = inL;
  modR = inR;
);

// Unvoiced noise is added to the carrier, then shaped by the synthesis bank
// and the modulator envelopes. Sens 0 and Unvoiced -96 stay exactly off.
uv_amp = 0;
uv_off ? (
  uv_env = 0;
) : (
  // 0 dB on the Unvoiced slider. A little above the -18 dBFS carrier,
  // so fricatives read as noise and vowels do not.
  uv_amp = uv_env * uv_lin * 0.18;
);
uv_amp > 0.00000001 ? (
  carL += (rand(2) - 1) * uv_amp;
  carR += (rand(2) - 1) * uv_amp;
);

sumL = 0;
sumR = 0;
e_all = 0;
e_hi = 0;
unity_dg = depth_mode < 0.5;
fast_enh = depth_mode > 0.5 && depth_mode < 1.5 && enh_mix > 0.999;
fast_dry = depth_mode > 0.5 && depth_mode < 1.5 && enh_mix < 0.001;
do_enh = enh_mix > 0.0005;
ch_mono = active_ch < 0.5;
ch_lr = active_ch > 1.5;
// Same carrier sample on both pins: one synthesis filter, two gains.
car_same = carL == carR;
bi = 0;
fast_share = fast_dry && gate_off && !ch_lr && !do_enh && (ch_mono || car_same) && n_run == n_bands;
fast_share ? (
  fast_bands();
  enh_peak += enh_pk_rel * (0 - enh_peak);
) : (
enh_seen = 0;
loop(n_run,
  cf = COEF + bi * CSTR;
  bm = cf[20];
  bm += bmix_c * ((bi < n_bands) - bm);
  cf[20] = bm;
  at = cf[10];
  at += att_sm_c * (cf[11] - at);
  at < 0.000000000001 ? at = 0;
  cf[10] = at;
  trim = cf[9] * cf[6] * cf[4] * at * bm * n_trim;
  fc_hz = cf[21];
  invr = cf[8];

  b_a1 = cf[12];
  b_a2 = cf[13];
  b_a3 = cf[14];
  b_k = cf[15];
  stA = STATE + bi * SSTR;

  p_ic1 = stA[0];
  p_ic2 = stA[1];
  p_v3 = modL - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stA[0] = p_v1 + p_v1 - p_ic1;
  stA[1] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_ic1 = stA[2];
  p_ic2 = stA[3];
  p_v3 = p_bp - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stA[2] = p_v1 + p_v1 - p_ic1;
  stA[3] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_v3 = b_k * p_v2;
  p_a2 = p_bp * p_bp + p_v3 * p_v3;
  p_amp = p_a2 > 0 ? sqrt(p_a2 * 0.5) : 0;
  p_ep = stA[4];
  p_amp > p_ep ? (p_ep += att_c * (p_amp - p_ep);) : (p_ep += rel_c * (p_amp - p_ep););
  p_ep < 0.000000000001 ? p_ep = 0;
  stA[4] = p_ep;
  envL = p_ep;
  // Instantaneous band power for the unvoiced ratio. The synthesis envelope
  // release is up to 450 ms, which would still read "fricative" through the
  // next vowel. The decision itself is smoothed later (Slow/Fast).
  instL = p_a2;
  gate_off ? (
    p_gg = stA[5];
    p_gg < 0.999 ? (
      p_gg += gate_c * (1 - p_gg);
      p_gg > 0.999 ? p_gg = 1;
      stA[5] = p_gg;
      stA[6] = 1;
    ) : p_gg = 1;
  ) : (
    p_op = stA[6];
    p_op > 0.5 ? (envL < gate_close_th ? p_op = 0;) : (envL >= gate_open_th ? p_op = 1;);
    stA[6] = p_op;
    p_gg = stA[5];
    p_gg += gate_c * (p_op - p_gg);
    p_gg < 0.0000001 ? p_gg = 0;
    stA[5] = p_gg;
  );
  gLgate = p_gg;

  ch_lr ? (
    stB = stA + LANE_STEP;
    p_ic1 = stB[0];
    p_ic2 = stB[1];
    p_v3 = modR - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stB[0] = p_v1 + p_v1 - p_ic1;
    stB[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stB[2];
    p_ic2 = stB[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stB[2] = p_v1 + p_v1 - p_ic1;
    stB[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_v3 = b_k * p_v2;
    p_a2 = p_bp * p_bp + p_v3 * p_v3;
    p_amp = p_a2 > 0 ? sqrt(p_a2 * 0.5) : 0;
    p_ep = stB[4];
    p_amp > p_ep ? (p_ep += att_c * (p_amp - p_ep);) : (p_ep += rel_c * (p_amp - p_ep););
    p_ep < 0.000000000001 ? p_ep = 0;
    stB[4] = p_ep;
    envR = p_ep;
    instR = p_a2;
    gate_off ? (
      p_gg = stB[5];
      p_gg < 0.999 ? (
        p_gg += gate_c * (1 - p_gg);
        p_gg > 0.999 ? p_gg = 1;
        stB[5] = p_gg;
        stB[6] = 1;
      ) : p_gg = 1;
    ) : (
      p_op = stB[6];
      p_op > 0.5 ? (envR < gate_close_th ? p_op = 0;) : (envR >= gate_open_th ? p_op = 1;);
      stB[6] = p_op;
      p_gg = stB[5];
      p_gg += gate_c * (p_op - p_gg);
      p_gg < 0.0000001 ? p_gg = 0;
      stB[5] = p_gg;
    );
    gRgate = p_gg;
    e_all += instL + instR;
    fc_hz >= 4000 ? e_hi += instL + instR;
    disp = envL > envR ? envL : envR;
  ) : (
    envR = envL;
    gRgate = gLgate;
    e_all += instL;
    fc_hz >= 4000 ? e_hi += instL;
    disp = envL;
  );
  DISP_ENV[bi] = disp * at;

  unity_dg ? (
    dgL = 1;
    dgR = 1;
  ) : fast_enh ? (
    dgL = envL * INV_REF_ENH;
    dgL > GAIN_CAP ? dgL = GAIN_CAP;
    ch_lr ? (
      dgR = envR * INV_REF_ENH;
      dgR > GAIN_CAP ? dgR = GAIN_CAP;
    ) : (
      dgR = dgL;
    );
  ) : fast_dry ? (
    // Unity at white-equivalent -18 dBFS. env == 0 already yields 0.
    dgL = envL * invr * INV_REF_DENS;
    dgL > GAIN_CAP ? dgL = GAIN_CAP;
    ch_lr ? (
      dgR = envR * invr * INV_REF_DENS;
      dgR > GAIN_CAP ? dgR = GAIN_CAP;
    ) : (
      dgR = dgL;
    );
  ) : (
    dgL = depth_gain(envL, invr);
    ch_lr ? dgR = depth_gain(envR, invr) : dgR = dgL;
  );

  b_a1 = cf[16];
  b_a2 = cf[17];
  b_a3 = cf[18];
  b_k = cf[19];
  stS = stA + LANE_STEP * 2;

  p_ic1 = stS[0];
  p_ic2 = stS[1];
  p_v3 = carL - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stS[0] = p_v1 + p_v1 - p_ic1;
  stS[1] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_ic1 = stS[2];
  p_ic2 = stS[3];
  p_v3 = p_bp - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stS[2] = p_v1 + p_v1 - p_ic1;
  stS[3] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  do_enh ? (
    p_a2 = p_bp * p_bp;
    p_ep = stS[7];
    p_a2 > p_ep ? (p_ep += enh_att * (p_a2 - p_ep);) : (p_ep += enh_rel * (p_a2 - p_ep););
    p_ep < 0.000000000000000000000001 ? p_ep = 0;
    stS[7] = p_ep;
    p_rms = p_ep > 0 ? sqrt(p_ep) : 0;
    p_boost = enh_boost(p_rms);
    p_bp *= enh_mix > 0.999 ? p_boost : (1 - enh_mix + enh_mix * p_boost);
  );
  sumL += p_bp * dgL * gLgate * trim;

  ch_mono ? 0 : car_same ? (
    sumR += p_bp * dgR * gRgate * trim;
    stT = stS + LANE_STEP;
    stT[0] = stS[0];
    stT[1] = stS[1];
    stT[2] = stS[2];
    stT[3] = stS[3];
    stT[7] = stS[7];
  ) : (
    stT = stS + LANE_STEP;
    p_ic1 = stT[0];
    p_ic2 = stT[1];
    p_v3 = carR - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stT[0] = p_v1 + p_v1 - p_ic1;
    stT[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stT[2];
    p_ic2 = stT[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stT[2] = p_v1 + p_v1 - p_ic1;
    stT[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    do_enh ? (
      p_a2 = p_bp * p_bp;
      p_ep = stT[7];
      p_a2 > p_ep ? (p_ep += enh_att * (p_a2 - p_ep);) : (p_ep += enh_rel * (p_a2 - p_ep););
      p_ep < 0.000000000000000000000001 ? p_ep = 0;
      stT[7] = p_ep;
      p_rms = p_ep > 0 ? sqrt(p_ep) : 0;
      p_boost = enh_boost(p_rms);
      p_bp *= enh_mix > 0.999 ? p_boost : (1 - enh_mix + enh_mix * p_boost);
    );
    sumR += p_bp * dgR * gRgate * trim;
  );
  bi += 1;
);
enh_seen > enh_peak ? (
  enh_peak += enh_pk_att * (enh_seen - enh_peak);
) : (
  enh_peak += enh_pk_rel * (enh_seen - enh_peak);
);
);

bi = n_run;
loop(MAXB - n_run,
  DISP_ENV[bi] = 0;
  bi += 1;
);

// Unvoiced detector from this sample's band energies. Level-independent ratio,
// plus an energy gate so silence is not fricative. Sens 100 forces the noise
// on whenever the modulator is above the energy gate.
uv_off ? (
  uv_env = 0;
) : (
  e_all > 0.0000000000000001 ? (
    total_rms = sqrt(e_all);
    hf_frac = e_hi / e_all;
  ) : (
    total_rms = 0;
    hf_frac = 0;
  );
  energy_ok = total_rms > uv_energy_lin;
  s_sens >= 99.9 ? (
    uv_target = energy_ok;
  ) : (
    uv_target = 0;
    energy_ok ? (
      uv_target = (hf_frac - uv_thr) * 6.6666667;
      uv_target < 0 ? uv_target = 0;
      uv_target > 1 ? uv_target = 1;
    );
  );
  uv_env += (uv_target > uv_env ? uv_att : uv_rel) * (uv_target - uv_env);
  uv_env < 0.000001 ? uv_env = 0;
);

// Constant broadband trim for Enhance off. Depth 0% stays at unity.
// Enhance on is already calibrated, so the trim fades out with enh_mix.
unity_dg ? (
  p_b = 1;
) : active_carrier < 0.5 ? (
  p_b = TRIM_NOISE;
) : active_carrier < 1.5 ? (
  p_b = TRIM_EXT;
) : active_carrier < 2.5 ? (
  p_b = TRIM_MOD;
) : (
  p_b = TRIM_PITCH;
);
unity_dg ? 0 : (
  p_b = enh_mix + (1 - enh_mix) * p_b;
);
sumL *= p_b;
ch_mono ? 0 : sumR *= p_b;

active_ch == 0 ? (
  dryL = modL;
  dryR = modL;
  sumR = sumL;
) : (
  dryL = inL;
  dryR = inR;
);

mix = wet * dev * duck;
procL = (dryL * (1 - wet) + sumL * wet) * lvl;
procR = (dryR * (1 - wet) + sumR * wet) * lvl;
spl0 = procL * dev * duck + dryL * (1 - dev * duck);
spl1 = procR * dev * duck + dryR * (1 - dev * duck);

spl0 != spl0 ? spl0 = 0;
spl1 != spl1 ? spl1 = 0;
abs(spl0) > 100000000 ? spl0 = 0;
abs(spl1) > 100000000 ? spl1 = 0;
abs(spl0) < 0.000000000000001 ? spl0 = 0;
abs(spl1) < 0.000000000000001 ? spl1 = 0;

// Pitch tracker: decimate the mono modulator, analyze when a hop is ready.
active_carrier == 3 ? (
  pm = (inL + inR) * 0.5;
  // 4th-order lowpass (two unity-gain SVF lows, Q ~ 0.707).
  ic1 = dec_a1; ic2 = dec_a2;
  v3 = pm - ic2;
  v1 = lp_a1 * ic1 + lp_a2 * v3;
  v2 = ic2 + lp_a2 * ic1 + lp_a3 * v3;
  dec_a1 = v1 + v1 - ic1;
  dec_a2 = v2 + v2 - ic2;
  ic1 = dec_b1; ic2 = dec_b2;
  v3 = v2 - ic2;
  v1 = lp_a1 * ic1 + lp_a2 * v3;
  v2 = ic2 + lp_a2 * ic1 + lp_a3 * v3;
  dec_b1 = v1 + v1 - ic1;
  dec_b2 = v2 + v2 - ic2;
  dec_i += 1;
  dec_i >= decim ? (
    dec_i = 0;
    RING[ring_w] = v2;
    ring_w += 1;
    ring_w >= RING_SIZE ? ring_w = 0;
    ring_fill < 1000000 ? ring_fill += 1;
    hop_count += 1;
    hop_count >= hop_n ? (
      hop_count = 0;
      yin_run();
    );
  );
);

@serialize
file_avail(0) < 0 ? (
  ser_ver = SER_VER;
  file_var(0, ser_ver);
  file_mem(0, BAND_ATT, MAXB);
) : file_avail(0) > 0 ? (
  file_var(0, ser_ver);
  ser_ver == SER_VER && file_avail(0) > 0 ? file_mem(0, BAND_ATT, MAXB);
);

@gfx 780 290

// Device panel. Slider edits use the bitmask form 2^(index-1) plus
// slider_automate so REAPER records undo and automation. BAND_ATT is not a
// slider: sliderchange(-1) from @gfx is the documented undo point, issued
// once when a band gesture ends (or immediately for a click reset).

function gui_c_bg() ( gfx_r = 49/255; gfx_g = 51/255; gfx_b = 54/255; gfx_a = 1; );
function gui_c_panel() ( gfx_r = 32/255; gfx_g = 34/255; gfx_b = 36/255; gfx_a = 1; );
function gui_c_screen() ( gfx_r = 16/255; gfx_g = 18/255; gfx_b = 20/255; gfx_a = 1; );
function gui_c_text() ( gfx_r = 230/255; gfx_g = 230/255; gfx_b = 230/255; gfx_a = 1; );
function gui_c_dim() ( gfx_r = 148/255; gfx_g = 150/255; gfx_b = 154/255; gfx_a = 1; );
function gui_c_teal() ( gfx_r = 42/255; gfx_g = 210/255; gfx_b = 216/255; gfx_a = 1; );
function gui_c_orange() ( gfx_r = 255/255; gfx_g = 149/255; gfx_b = 18/255; gfx_a = 1; );
function gui_c_ink() ( gfx_r = 36/255; gfx_g = 24/255; gfx_b = 14/255; gfx_a = 1; );
function gui_c_line() ( gfx_r = 18/255; gfx_g = 18/255; gfx_b = 20/255; gfx_a = 1; );
function gui_c_knob() ( gfx_r = 22/255; gfx_g = 24/255; gfx_b = 26/255; gfx_a = 1; );
function gui_c_track() ( gfx_r = 78/255; gfx_g = 80/255; gfx_b = 84/255; gfx_a = 1; );

function gui_X(v) ( gui_ox + v * gui_s; );
function gui_Y(v) ( gui_oy + v * gui_s; );
function gui_S(v) ( v * gui_s; );

function gui_box(x, y, w, h) local(x2, y2) (
  x2 = x + w - 1;
  y2 = y + h - 1;
  gfx_line(x, y, x2, y, 0);
  gfx_line(x2, y, x2, y2, 0);
  gfx_line(x2, y2, x, y2, 0);
  gfx_line(x, y2, x, y, 0);
);

function gui_in(x, y, w, h) (
  mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
);
function gui_in_knob(cx, cy, r) (
  gui_in(cx - r - gui_S(8), cy - r - gui_S(14), r * 2 + gui_S(16), r * 2 + gui_S(32));
);
function gui_hit_pow() local(dx, dy, rr) (
  dx = mouse_x - r_pow_x;
  dy = mouse_y - r_pow_y;
  rr = r_pow_r + gui_S(5);
  dx * dx + dy * dy <= rr * rr;
);

function gui_q(val, lo, hi, step) local(q) (
  val < lo ? val = lo;
  val > hi ? val = hi;
  q = floor(val / step + 0.5) * step;
  q < lo ? q = lo;
  q > hi ? q = hi;
  q;
);
function gui_linn(val, lo, hi) local(n) (
  n = (val - lo) / (hi - lo);
  n < 0 ? 0 : (n > 1 ? 1 : n);
);
function gui_logn(val, lo, hi) local(n) (
  val < lo ? val = lo;
  val > hi ? val = hi;
  n = log(val / lo) / log(hi / lo);
  n < 0 ? 0 : (n > 1 ? 1 : n);
);
function gui_lin_set(val, lo, hi, step, dy) local(d) (
  d = dy / (160 * gui_s) * (hi - lo);
  gui_shift ? d *= 0.1;
  gui_q(val + d, lo, hi, step);
);
function gui_log_set(val, lo, hi, step, dy) local(n, d) (
  val < lo ? val = lo;
  n = log(val / lo) / log(hi / lo);
  d = dy / (160 * gui_s);
  gui_shift ? d *= 0.1;
  n += d;
  n < 0 ? n = 0;
  n > 1 ? n = 1;
  gui_q(lo * exp(n * log(hi / lo)), lo, hi, step);
);
function gui_lin_wheel(val, lo, hi, step) local(d) (
  d = gui_wheel * (gui_shift ? step : max(step, (hi - lo) * 0.04));
  gui_q(val + d, lo, hi, step);
);
function gui_log_wheel(val, lo, hi, step) local(n, d) (
  val < lo ? val = lo;
  n = log(val / lo) / log(hi / lo);
  d = gui_wheel * (gui_shift ? 0.01 : 0.05);
  n += d;
  n < 0 ? n = 0;
  n > 1 ? n = 1;
  gui_q(lo * exp(n * log(hi / lo)), lo, hi, step);
);

function gui_commit(idx) (
  gui_mask = 2 ^ (idx - 1);
  sliderchange(gui_mask);
  slider_automate(gui_mask, 0);
);
function gui_end(idx) (
  gui_mask = 2 ^ (idx - 1);
  slider_automate(gui_mask, 1);
);
function gui_dirty() ( sliderchange(-1); );
function gui_push(idx, val) (
  slider(idx) = val;
  gui_commit(idx);
  gui_moved = 1;
);
function gui_set(idx, val) (
  slider(idx) = val;
  gui_commit(idx);
  gui_end(idx);
);
function gui_drag_lin(idx, lo, hi, step) local(dy, old, nv) (
  dy = gui_prev_y - mouse_y;
  abs(dy) > 0.01 ? (
    old = slider(idx);
    nv = gui_lin_set(old, lo, hi, step, dy);
    abs(nv - old) > step * 0.25 ? gui_push(idx, nv);
  );
);
function gui_drag_log(idx, lo, hi, step) local(dy, old, nv) (
  dy = gui_prev_y - mouse_y;
  abs(dy) > 0.01 ? (
    old = slider(idx);
    nv = gui_log_set(old, lo, hi, step, dy);
    abs(nv - old) > step * 0.25 ? gui_push(idx, nv);
  );
);
function gui_wheel_lin(idx, lo, hi, step) local(old, nv) (
  old = slider(idx);
  nv = gui_lin_wheel(old, lo, hi, step);
  abs(nv - old) > step * 0.25 ? gui_set(idx, nv);
);
function gui_wheel_log(idx, lo, hi, step) local(old, nv) (
  old = slider(idx);
  nv = gui_log_wheel(old, lo, hi, step);
  abs(nv - old) > step * 0.25 ? gui_set(idx, nv);
);

function gui_ctrl(id, idx, x, y, w, h, lo, hi, step, dflt, islog, knob) local(hit) (
  hit = knob ? gui_in_knob(x, y, w) : gui_in(x, y, w, h);
  gui_drag == id && !gui_click && (gui_lmb || gui_up) ? (
    islog ? gui_drag_log(idx, lo, hi, step) : gui_drag_lin(idx, lo, hi, step);
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && hit ? (
    (gui_click_id == id && (time_precise() - gui_click_t) < 0.35) ? (
      gui_set(idx, dflt);
      gui_drag = 0;
    ) : (
      gui_drag = id;
      gui_drag_idx = idx;
      gui_moved = 0;
    );
    gui_hit_id = id;
  );
  gui_drag == 0 && !gui_click && gui_hit_id == 0 && hit && abs(gui_wheel) >= 0.5 ? (
    islog ? gui_wheel_log(idx, lo, hi, step) : gui_wheel_lin(idx, lo, hi, step);
    gui_hit_id = id;
  );
);

function gui_band_at(mx) local(t, i) (
  t = (mx - r_bar_x) / max(r_bar_w, 1);
  t < 0 ? t = 0;
  t > 0.999999 ? t = 0.999999;
  i = floor(t * gui_nb);
  i < 0 ? i = 0;
  i >= gui_nb ? i = gui_nb - 1;
  i;
);
function gui_att_at(my) local(t) (
  t = (my - r_bar_y) / max(r_bar_h, 1);
  t < 0 ? t = 0;
  t > 1 ? t = 1;
  gui_q(-60 * t, -60, 0, 0.1);
);
function gui_band_span(i0, a0, i1, a1) local(i, att, dir, n) (
  i0 < 0 ? i0 = 0;
  i1 < 0 ? i1 = 0;
  i0 >= gui_nb ? i0 = gui_nb - 1;
  i1 >= gui_nb ? i1 = gui_nb - 1;
  i0 == i1 ? (
    att = gui_q(a1, -60, 0, 0.1);
    abs(BAND_ATT[i0] - att) > 0.05 ? (
      BAND_ATT[i0] = att;
      gui_bdirty = 1;
    );
  ) : (
    dir = i1 > i0 ? 1 : -1;
    n = abs(i1 - i0);
    i = i0;
    loop(n + 1,
      att = a0 + (a1 - a0) * (i - i0) / (i1 - i0);
      att = gui_q(att, -60, 0, 0.1);
      abs(BAND_ATT[i] - att) > 0.05 ? (
        BAND_ATT[i] = att;
        gui_bdirty = 1;
      );
      i += dir;
    );
  );
);

function gui_xy_input() local(nx, ny, rv, cv) (
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_pad_x, r_pad_y, r_pad_w, r_pad_h) ? (
    (gui_click_id == 16 && (time_precise() - gui_click_t) < 0.35) ? (
      gui_set(19, 1);
      gui_set(20, 1);
      gui_drag = 0;
    ) : (
      gui_drag = 16;
      gui_xy_r = 0;
      gui_xy_c = 0;
      gui_moved = 0;
    );
    gui_hit_id = 16;
  );
  gui_drag == 16 && (gui_lmb || gui_up) ? (
    nx = (mouse_x - r_pad_x) / max(r_pad_w, 1);
    ny = 1 - (mouse_y - r_pad_y) / max(r_pad_h, 1);
    nx < 0 ? nx = 0;
    nx > 1 ? nx = 1;
    ny < 0 ? ny = 0;
    ny > 1 ? ny = 1;
    rv = gui_q(nx, 0, 1, 0.01);
    cv = gui_q(ny, 0, 1, 0.01);
    abs(rv - slider(19)) >= 0.005 ? (
      gui_push(19, rv);
      gui_xy_r = 1;
    );
    abs(cv - slider(20)) >= 0.005 ? (
      gui_push(20, cv);
      gui_xy_c = 1;
    );
  );
  gui_drag == 0 && !gui_click && gui_hit_id == 0 && gui_in(r_pad_x, r_pad_y, r_pad_w, r_pad_h) && abs(gui_wheel) >= 0.5 ? (
    gui_shift ? gui_wheel_lin(19, 0, 1, 0.01) : gui_wheel_lin(20, 0, 1, 0.01);
    gui_hit_id = 16;
  );
);

function gui_band_input() local(hit, zb, za, zi, zany) (
  hit = gui_in(r_disp_x, r_disp_y, r_disp_w, r_disp_h);
  gui_click && gui_drag == 0 && gui_hit_id == 0 && hit ? (
    gui_alt ? (
      zi = 0;
      zany = 0;
      loop(40,
        abs(BAND_ATT[zi]) > 0.05 ? (
          BAND_ATT[zi] = 0;
          zany = 1;
        );
        zi += 1;
      );
      zany ? gui_dirty();
      gui_drag = 0;
      gui_bdirty = 0;
    ) : (
      zb = gui_band_at(mouse_x);
      (gui_click_id == 1000 + zb && (time_precise() - gui_click_t) < 0.35) ? (
        abs(BAND_ATT[zb]) > 0.05 ? (
          BAND_ATT[zb] = 0;
          gui_dirty();
        );
        gui_drag = 0;
      ) : (
        gui_drag = 17;
        gui_bdirty = 0;
      );
    );
    gui_hit_id = 1000 + gui_band_at(mouse_x);
  );
  gui_drag == 17 && (gui_lmb || gui_up) ? (
    zb = gui_band_at(mouse_x);
    za = gui_att_at(mouse_y);
    gui_click ? gui_band_span(zb, za, zb, za) : gui_band_span(gui_last_i, gui_last_a, zb, za);
    gui_last_i = zb;
    gui_last_a = za;
  );
);

function gui_menu_geom() local(n, ih, y, h) (
  ih = gui_S(18);
  gui_menu == 1 ? (
    gui_mx = r_car_x;
    gui_mw = r_car_w;
    n = 4;
    y = r_car_y + r_car_h + gui_S(2);
  ) : gui_menu == 2 ? (
    gui_mx = r_bnd_x;
    gui_mw = max(r_bnd_w, gui_S(56));
    n = 10;
    y = r_bnd_y - n * ih;
  ) : (
    gui_mx = r_wave_x;
    gui_mw = r_wave_w;
    n = 4;
    y = r_wave_y + r_wave_h + gui_S(2);
  );
  h = n * ih;
  y < 2 ? y = 2;
  y + h > gfx_h - 2 ? y = gfx_h - 2 - h;
  gui_mx < 2 ? gui_mx = 2;
  gui_mx + gui_mw > gfx_w - 2 ? gui_mx = gfx_w - 2 - gui_mw;
  gui_my = y;
  gui_mih = ih;
  gui_mn = n;
);
function gui_menu_input() local(j, hit) (
  gui_menu <= 0 ? 0 : (
    gui_blocked = 1;
    gui_menu_geom();
    !gui_lmb ? gui_arm = 1;
    gui_arm && gui_click ? (
      hit = gui_in(gui_mx, gui_my, gui_mw, gui_mn * gui_mih);
      hit ? (
        j = floor((mouse_y - gui_my) / gui_mih);
        j < 0 ? j = 0;
        j >= gui_mn ? j = gui_mn - 1;
        gui_menu == 1 ? gui_set(1, j) : gui_menu == 2 ? gui_set(2, j) : gui_set(21, j);
      );
      gui_menu = 0;
      gui_arm = 0;
      gui_hit_id = 0;
    );
  );
);

function gui_release() (
  gui_up && gui_drag ? (
    gui_drag == 17 ? (
      gui_bdirty ? gui_dirty();
      gui_bdirty = 0;
    ) : gui_drag == 16 ? (
      gui_xy_r ? gui_end(19);
      gui_xy_c ? gui_end(20);
    ) : gui_moved ? (
      gui_end(gui_drag_idx);
    );
    gui_drag = 0;
    gui_moved = 0;
    gui_xy_r = 0;
    gui_xy_c = 0;
  );
);

function gui_controls() (
  gui_hit_pow() && gui_click && gui_drag == 0 && gui_hit_id == 0 ? (
    gui_set(25, s_device > 0.5 ? 0 : 1);
    gui_hit_id = 39;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_car_x, r_car_y, r_car_w, r_car_h) ? (
    gui_menu = 1;
    gui_arm = 0;
    gui_hit_id = 30;
  );
  s_carrier >= 2.5 && gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_wave_x, r_wave_y, r_wave_w, r_wave_h) ? (
    gui_menu = 3;
    gui_arm = 0;
    gui_hit_id = 32;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_enh_x, r_enh_y, r_enh_w, r_enh_h) ? (
    gui_set(15, s_enhance > 0.5 ? 0 : 1);
    gui_hit_id = 33;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_spd_x, r_spd_y, r_spd_w, r_spd_h) ? (
    gui_set(18, s_uvspeed > 0.5 ? 0 : 1);
    gui_hit_id = 34;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_ch_x, r_ch_y0, r_ch_w, r_ch_h) ? (
    gui_set(14, 0);
    gui_hit_id = 36;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_ch_x, r_ch_y1, r_ch_w, r_ch_h) ? (
    gui_set(14, 1);
    gui_hit_id = 37;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_ch_x, r_ch_y2, r_ch_w, r_ch_h) ? (
    gui_set(14, 2);
    gui_hit_id = 38;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_fm_x, r_fm_y, r_fm_w, r_fm_h) ? (
    gui_set(6, s_fmode > 0.5 ? 0 : 1);
    gui_hit_id = 35;
  );
  gui_click && gui_drag == 0 && gui_hit_id == 0 && gui_in(r_bnd_x, r_bnd_y, r_bnd_w, r_bnd_h) ? (
    gui_menu = 2;
    gui_arm = 0;
    gui_hit_id = 31;
  );
  gui_ctrl(1, 9, r_dp_x, r_dp_y, r_dp_r, 0, 0, 200, 1, 100, 0, 1);
  gui_ctrl(2, 10, r_ak_x, r_ak_y, r_ak_r, 0, 0.1, 100, 0.1, 5, 1, 1);
  gui_ctrl(3, 11, r_re_x, r_re_y, r_re_r, 0, 1, 1000, 1, 80, 1, 1);
  gui_ctrl(4, 12, r_fo_x, r_fo_y, r_fo_r, 0, -12, 12, 0.1, 0, 0, 1);
  gui_ctrl(5, 13, r_dw_x, r_dw_y, r_dw_r, 0, 0, 100, 1, 100, 0, 1);
  gui_ctrl(6, 16, r_uv_x, r_uv_y, r_uv_r, 0, -96, 0, 1, -96, 0, 1);
  gui_ctrl(7, 17, r_sens_x, r_sens_y, r_sens_w, r_sens_h, 0, 100, 1, 50, 0, 0);
  gui_ctrl(8, 5, r_bw_x, r_bw_y, r_bw_w, r_bw_h, 10, 200, 1, 100, 0, 0);
  gui_ctrl(9, 7, r_gt_x, r_gt_y, r_gt_w, r_gt_h, -96, 0, 1, -96, 0, 0);
  gui_ctrl(10, 8, r_lv_x, r_lv_y, r_lv_w, r_lv_h, -24, 24, 0.1, 0, 0, 0);
  gui_ctrl(11, 3, r_rl_x, r_rl_y, r_rl_w, r_rl_h, 20, 2000, 1, 80, 1, 0);
  gui_ctrl(12, 4, r_rh_x, r_rh_y, r_rh_w, r_rh_h, 1000, 20000, 1, 18000, 1, 0);
  s_carrier < 0.5 ? gui_xy_input() : 0;
  s_carrier >= 2.5 ? (
    gui_ctrl(13, 22, r_pit_x, r_pit_y, r_pit_w, r_pit_h, -24, 24, 1, 0, 0, 0);
    gui_ctrl(14, 23, r_lo_x, r_lo_y, r_lo_w, r_lo_h, 20, 1000, 1, 60, 1, 0);
    gui_ctrl(15, 24, r_hi_x, r_hi_y, r_hi_w, r_hi_h, 100, 2000, 1, 1000, 1, 0);
  );
  gui_band_input();
);

function gui_begin() local(zk) (
  gui_s = min(gfx_w / 780, gfx_h / 290);
  gui_s < 0.6 ? gui_s = 0.6;
  gui_ox = (gfx_w - 780 * gui_s) * 0.5;
  gui_oy = (gfx_h - 290 * gui_s) * 0.5;
  gui_fs = floor(11 * gui_s + 0.5);
  gui_fb = floor(16 * gui_s + 0.5);
  gui_fm = floor(10 * gui_s + 0.5);
  gui_fs < 8 ? gui_fs = 8;
  gui_fb < 8 ? gui_fb = 8;
  gui_fm < 8 ? gui_fm = 8;
  gui_fs > 64 ? gui_fs = 64;
  gui_fb > 72 ? gui_fb = 72;
  gui_fm > 48 ? gui_fm = 48;
  gfx_setfont(1, "Arial", gui_fs);
  gfx_setfont(2, "Arial", gui_fb, 'b');
  gfx_setfont(3, "Arial", gui_fm);
  gfx_setfont(1);
  zk = 0;
  loop(4, zk = gfx_getchar(0); );
  gui_lmb = mouse_cap & 1;
  gui_click = gui_lmb && !(gui_prev_cap & 1);
  gui_up = !gui_lmb && (gui_prev_cap & 1);
  gui_shift = mouse_cap & 8;
  gui_alt = mouse_cap & 16;
  gui_wheel = mouse_wheel / 120;
  mouse_wheel = 0;
  mouse_hwheel = 0;
);

function gui_layout() (
  r_pow_x = gui_X(16);
  r_pow_y = gui_Y(13);
  r_pow_r = gui_S(6.5);
  r_car_x = gui_X(10);
  r_car_y = gui_Y(42);
  r_car_w = gui_S(142);
  r_car_h = gui_S(18);
  r_ctx_x = gui_X(10);
  r_ctx_y = gui_Y(66);
  r_ctx_w = gui_S(142);
  r_ctx_h = gui_S(108);
  r_pad_x = gui_X(16);
  r_pad_y = gui_Y(72);
  r_pad_w = gui_S(130);
  r_pad_h = gui_S(96);
  r_wave_x = gui_X(16);
  r_wave_y = gui_Y(80);
  r_wave_w = gui_S(130);
  r_wave_h = gui_S(16);
  r_pit_x = gui_X(16);
  r_pit_y = gui_Y(102);
  r_pit_w = gui_S(130);
  r_pit_h = gui_S(16);
  r_lo_x = gui_X(16);
  r_lo_y = gui_Y(122);
  r_lo_w = gui_S(130);
  r_lo_h = gui_S(16);
  r_hi_x = gui_X(16);
  r_hi_y = gui_Y(142);
  r_hi_w = gui_S(130);
  r_hi_h = gui_S(16);
  r_enh_x = gui_X(10);
  r_enh_y = gui_Y(180);
  r_enh_w = gui_S(68);
  r_enh_h = gui_S(16);
  r_uv_x = gui_X(40);
  r_uv_y = gui_Y(232);
  r_uv_r = gui_S(15);
  r_sens_x = gui_X(90);
  r_sens_y = gui_Y(208);
  r_sens_w = gui_S(58);
  r_sens_h = gui_S(16);
  r_spd_x = gui_X(90);
  r_spd_y = gui_Y(232);
  r_spd_w = gui_S(58);
  r_spd_h = gui_S(16);
  r_disp_x = gui_X(164);
  r_disp_y = gui_Y(32);
  r_disp_w = gui_S(432);
  r_disp_h = gui_S(170);
  r_bar_x = r_disp_x + gui_S(8);
  r_bar_y = r_disp_y + gui_S(8);
  r_bar_w = r_disp_w - gui_S(16);
  r_bar_h = r_disp_h - gui_S(16);
  r_bnd_x = gui_X(164);
  r_bnd_y = gui_Y(220);
  r_bnd_w = gui_S(48);
  r_bnd_h = gui_S(18);
  r_rl_x = gui_X(222);
  r_rl_y = gui_Y(220);
  r_rl_w = gui_S(66);
  r_rl_h = gui_S(16);
  r_rh_x = gui_X(222);
  r_rh_y = gui_Y(240);
  r_rh_w = gui_S(66);
  r_rh_h = gui_S(16);
  r_bw_x = gui_X(298);
  r_bw_y = gui_Y(220);
  r_bw_w = gui_S(50);
  r_bw_h = gui_S(18);
  r_fm_x = gui_X(356);
  r_fm_y = gui_Y(220);
  r_fm_w = gui_S(72);
  r_fm_h = gui_S(18);
  r_gt_x = gui_X(436);
  r_gt_y = gui_Y(220);
  r_gt_w = gui_S(56);
  r_gt_h = gui_S(18);
  r_lv_x = gui_X(500);
  r_lv_y = gui_Y(220);
  r_lv_w = gui_S(62);
  r_lv_h = gui_S(18);
  r_dp_x = gui_X(652);
  r_dp_y = gui_Y(70);
  r_dp_r = gui_S(16);
  r_ch_x = gui_X(704);
  r_ch_w = gui_S(64);
  r_ch_h = gui_S(16);
  r_ch_y0 = gui_Y(40);
  r_ch_y1 = gui_Y(60);
  r_ch_y2 = gui_Y(80);
  r_ak_x = gui_X(652);
  r_ak_y = gui_Y(162);
  r_ak_r = gui_S(14);
  r_fo_x = gui_X(732);
  r_fo_y = gui_Y(162);
  r_fo_r = gui_S(14);
  r_re_x = gui_X(652);
  r_re_y = gui_Y(246);
  r_re_r = gui_S(14);
  r_dw_x = gui_X(732);
  r_dw_y = gui_Y(246);
  r_dw_r = gui_S(14);
  gui_nb = (floor(s_bands + 0.5) + 1) * 4;
  gui_nb < 4 ? gui_nb = 4;
  gui_nb > 40 ? gui_nb = 40;
);

function gui_input() (
  gui_hit_id = 0;
  gui_blocked = 0;
  gui_menu > 0 ? gui_menu_input() : 0;
  gui_blocked ? 0 : gui_controls();
  gui_release();
  gui_click ? (
    gui_click_t = time_precise();
    gui_click_id = gui_hit_id;
  );
);

function gui_arc(cx, cy, r, a0, a1) local(n, i) (
  n = gui_s >= 2.2 ? 3 : (gui_s >= 1.35 ? 2 : 1);
  i = 0;
  loop(n,
    gfx_arc(cx, cy, r - i, a0, a1, 1);
    i += 1;
  );
);
function gui_knob(cx, cy, r, norm) local(a0, a1, ang, rad) (
  norm < 0 ? norm = 0;
  norm > 1 ? norm = 1;
  gui_c_knob();
  gfx_circle(cx, cy, r, 1, 1);
  gui_c_line();
  gfx_circle(cx, cy, r, 0, 1);
  a0 = gui_a0;
  rad = r - max(1, gui_s);
  gui_c_track();
  gui_arc(cx, cy, rad, a0, a0 + gui_asweep);
  a1 = a0 + gui_asweep * norm;
  gui_c_teal();
  norm > 0.004 ? gui_arc(cx, cy, rad, a0, a1);
  ang = a1;
  gfx_line(cx + sin(ang) * (r * 0.22), cy - cos(ang) * (r * 0.22), cx + sin(ang) * max(1, rad - gui_s), cy - cos(ang) * max(1, rad - gui_s), 1);
);
function gui_kcap(cx, cy, r) (
  gui_c_dim();
  gfx_setfont(3);
  gfx_x = cx - gui_S(42);
  gfx_y = cy - r - gui_fm - gui_S(2);
  gfx_drawstr(#gui_s, 5, cx + gui_S(42), cy - r);
);
function gui_kval(cx, cy, r) (
  gui_c_teal();
  gfx_setfont(1);
  gfx_x = cx - gui_S(44);
  gfx_y = cy + r + gui_S(1);
  gfx_drawstr(#gui_s, 5, cx + gui_S(44), cy + r + gui_fs + gui_S(3));
);
function gui_above_l(x, y) (
  gui_c_dim();
  gfx_setfont(3);
  gfx_x = x;
  gfx_y = y - gui_fm - gui_S(2);
  gfx_drawstr(#gui_s);
);
function gui_btn(x, y, w, h, on) (
  on ? gui_c_orange() : gui_c_panel();
  gfx_rect(x, y, w, h);
  gui_c_line();
  gui_box(x, y, w, h);
  on ? gui_c_ink() : gui_c_text();
  gfx_setfont(1);
  gfx_x = x;
  gfx_y = y;
  gfx_drawstr(#gui_s, 5, x + w, y + h);
);
function gui_drop(x, y, w, h, open) local(cw) (
  gui_c_panel();
  gfx_rect(x, y, w, h);
  open ? gui_c_orange() : gui_c_teal();
  gui_box(x, y, w, h);
  gui_c_text();
  gfx_setfont(1);
  gfx_x = x + gui_S(5);
  gfx_y = y;
  gfx_drawstr(#gui_s, 4, x + w - gui_S(14), y + h);
  gui_c_dim();
  cw = max(4, gui_S(5));
  gfx_triangle(x + w - gui_S(12), y + h * 0.38, x + w - gui_S(12) + cw, y + h * 0.38, x + w - gui_S(12) + cw * 0.5, y + h * 0.38 + cw * 0.7);
);
function gui_num(x, y, w, h) (
  gui_c_panel();
  gfx_rect(x, y, w, h);
  gui_c_line();
  gui_box(x, y, w, h);
  gui_c_teal();
  gfx_setfont(1);
  gfx_x = x;
  gfx_y = y;
  gfx_drawstr(#gui_s, 5, x + w, y + h);
);
function gui_row_l(x, y, w, h) (
  gui_c_dim();
  gfx_setfont(3);
  gfx_x = x + gui_S(4);
  gfx_y = y;
  gfx_drawstr(#gui_s, 4, x + gui_S(46), y + h);
);
function gui_row_v(x, y, w, h) (
  gui_c_teal();
  gfx_setfont(1);
  gfx_x = x + gui_S(40);
  gfx_y = y;
  gfx_drawstr(#gui_s, 6, x + w - gui_S(4), y + h);
);
function gui_hint() (
  gui_c_text();
  gfx_setfont(1);
  gfx_x = r_ctx_x + gui_S(4);
  gfx_y = r_ctx_y;
  gfx_drawstr(#gui_s, 5, r_ctx_x + r_ctx_w - gui_S(4), r_ctx_y + r_ctx_h);
);

function gui_name_carrier(v) (
  v < 0.5 ? sprintf(#gui_s, "Noise") : v < 1.5 ? sprintf(#gui_s, "External") : v < 2.5 ? sprintf(#gui_s, "Modulator") : sprintf(#gui_s, "Pitch Tracking");
);
function gui_name_wave(v) (
  v < 0.5 ? sprintf(#gui_s, "Saw") : v < 1.5 ? sprintf(#gui_s, "Pulse 50%%") : v < 2.5 ? sprintf(#gui_s, "Pulse 25%%") : sprintf(#gui_s, "Pulse 12.5%%");
);
function gui_fmt_pct(val) ( sprintf(#gui_s, "%.0f%%", val); );
function gui_fmt_ms(val, coarse) (
  coarse || val >= 10 ? sprintf(#gui_s, "%.0f ms", val) : sprintf(#gui_s, "%.1f ms", val);
);
function gui_fmt_db(val, dec) (
  val <= -95.5 ? sprintf(#gui_s, "-inf") : dec ? (abs(val) < 0.05 ? sprintf(#gui_s, "0.0 dB") : sprintf(#gui_s, "%+.1f dB", val)) : sprintf(#gui_s, "%.0f dB", val);
);
function gui_fmt_st(val, dec) (
  dec ? (abs(val) < 0.05 ? sprintf(#gui_s, "0.0 st") : sprintf(#gui_s, "%+.1f st", val)) : (abs(val) < 0.5 ? sprintf(#gui_s, "0 st") : sprintf(#gui_s, "%+.0f st", val));
);
function gui_fmt_hz(val) local(k, r) (
  val >= 999.5 ? (
    k = val / 1000;
    k >= 10 ? (
      r = floor(k + 0.5);
      abs(k - r) < 0.05 ? sprintf(#gui_s, "%.0fk", k) : sprintf(#gui_s, "%.1fk", k);
    ) : (
      sprintf(#gui_s, "%.1fk", k);
    );
  ) : (
    sprintf(#gui_s, "%.0f Hz", val);
  );
);

function gui_paint_bg() (
  gfx_r = 28/255; gfx_g = 29/255; gfx_b = 31/255; gfx_a = 1;
  gfx_rect(0, 0, gfx_w, gfx_h);
  gui_c_bg();
  gfx_rect(gui_ox, gui_oy, gui_S(780), gui_S(290));
  gui_c_panel();
  gfx_rect(gui_ox, gui_oy, gui_S(780), gui_S(26));
  gui_c_line();
  gfx_line(gui_ox, gui_oy + gui_S(26), gui_ox + gui_S(780), gui_oy + gui_S(26), 0);
  gfx_line(gui_X(156), gui_Y(32), gui_X(156), gui_Y(276), 0);
  gfx_line(gui_X(606), gui_Y(32), gui_X(606), gui_Y(276), 0);
);
function gui_paint_power() (
  s_device > 0.5 ? (
    gui_c_orange();
    gfx_circle(r_pow_x, r_pow_y, r_pow_r, 1, 1);
  ) : (
    gui_c_knob();
    gfx_circle(r_pow_x, r_pow_y, r_pow_r, 1, 1);
    gui_c_dim();
    gfx_circle(r_pow_x, r_pow_y, r_pow_r, 0, 1);
  );
  gui_c_text();
  gfx_setfont(2);
  gfx_x = gui_X(30);
  gfx_y = gui_Y(4);
  gfx_drawstr("Vocoder");
);
function gui_paint_pad() local(dx, dy, rad, span) (
  gui_c_screen();
  gfx_rect(r_pad_x, r_pad_y, r_pad_w, r_pad_h);
  gui_c_line();
  gui_box(r_pad_x, r_pad_y, r_pad_w, r_pad_h);
  gui_c_dim();
  gfx_a = 0.28;
  gfx_line(r_pad_x + r_pad_w * 0.5, r_pad_y + gui_S(3), r_pad_x + r_pad_w * 0.5, r_pad_y + r_pad_h - gui_S(3), 0);
  gfx_line(r_pad_x + gui_S(3), r_pad_y + r_pad_h * 0.5, r_pad_x + r_pad_w - gui_S(3), r_pad_y + r_pad_h * 0.5, 0);
  gfx_a = 1;
  gui_c_dim();
  gfx_setfont(3);
  sprintf(#gui_s, "Crackle %.2f", max(0, min(1, s_ncrack)));
  gfx_x = r_pad_x + gui_S(4);
  gfx_y = r_pad_y + gui_S(3);
  gfx_drawstr(#gui_s);
  sprintf(#gui_s, "Rate %.2f", max(0, min(1, s_nrate)));
  gfx_x = r_pad_x + gui_S(4);
  gfx_y = r_pad_y + r_pad_h - gui_fm - gui_S(3);
  gfx_drawstr(#gui_s);
  rad = max(3, gui_S(4.5));
  span = rad + gui_S(2);
  dx = r_pad_x + span + max(0, min(1, s_nrate)) * max(1, r_pad_w - span * 2);
  dy = r_pad_y + span + (1 - max(0, min(1, s_ncrack))) * max(1, r_pad_h - span * 2);
  gui_c_knob();
  gfx_circle(dx, dy, rad, 1, 1);
  gui_c_teal();
  gfx_circle(dx, dy, max(2, rad * 0.62), 1, 1);
);
function gui_paint_pitch() (
  gui_name_wave(s_wave);
  gui_drop(r_wave_x, r_wave_y, r_wave_w, r_wave_h, gui_menu == 3);
  sprintf(#gui_s, "Pitch");
  gui_row_l(r_pit_x, r_pit_y, r_pit_w, r_pit_h);
  gui_fmt_st(s_opitch, 0);
  gui_row_v(r_pit_x, r_pit_y, r_pit_w, r_pit_h);
  sprintf(#gui_s, "Low");
  gui_row_l(r_lo_x, r_lo_y, r_lo_w, r_lo_h);
  gui_fmt_hz(s_tlow);
  gui_row_v(r_lo_x, r_lo_y, r_lo_w, r_lo_h);
  sprintf(#gui_s, "High");
  gui_row_l(r_hi_x, r_hi_y, r_hi_w, r_hi_h);
  gui_fmt_hz(s_thigh);
  gui_row_v(r_hi_x, r_hi_y, r_hi_w, r_hi_h);
);
function gui_paint_left() (
  sprintf(#gui_s, "Carrier");
  gui_above_l(r_car_x, r_car_y);
  gui_name_carrier(s_carrier);
  gui_drop(r_car_x, r_car_y, r_car_w, r_car_h, gui_menu == 1);
  gui_c_panel();
  gfx_rect(r_ctx_x, r_ctx_y, r_ctx_w, r_ctx_h);
  gui_c_line();
  gui_box(r_ctx_x, r_ctx_y, r_ctx_w, r_ctx_h);
  s_carrier < 0.5 ? gui_paint_pad() : s_carrier < 1.5 ? (
    sprintf(#gui_s, "Sidechain: ch 3/4");
    gui_hint();
  ) : s_carrier < 2.5 ? (
    sprintf(#gui_s, "Carrier = modulator");
    gui_hint();
  ) : gui_paint_pitch();
  sprintf(#gui_s, "Enhance");
  gui_btn(r_enh_x, r_enh_y, r_enh_w, r_enh_h, s_enhance > 0.5);
  sprintf(#gui_s, "Unvoiced");
  gui_kcap(r_uv_x, r_uv_y, r_uv_r);
  gui_knob(r_uv_x, r_uv_y, r_uv_r, gui_linn(s_unvoiced, -96, 0));
  gui_fmt_db(s_unvoiced, 0);
  gui_kval(r_uv_x, r_uv_y, r_uv_r);
  sprintf(#gui_s, "Sens.");
  gui_above_l(r_sens_x, r_sens_y);
  gui_fmt_pct(s_sens);
  gui_num(r_sens_x, r_sens_y, r_sens_w, r_sens_h);
  s_uvspeed > 0.5 ? sprintf(#gui_s, "Fast") : sprintf(#gui_s, "Slow");
  gui_btn(r_spd_x, r_spd_y, r_spd_w, r_spd_h, s_uvspeed > 0.5);
);
function gui_paint_bands() local(i, x1, x2, w, gap, env, db, t, bh, att, my) (
  i = 0;
  gap = gui_nb >= 24 ? 1 : 2;
  loop(gui_nb,
    x1 = floor(r_bar_x + i * r_bar_w / gui_nb);
    x2 = floor(r_bar_x + (i + 1) * r_bar_w / gui_nb);
    w = x2 - x1 - gap;
    w < 1 ? w = 1;
    env = DISP_ENV[i];
    db = env > 0.000000000001 ? log(env) / DB2A : -120;
    t = (db + 60) / 60;
    t < 0 ? t = 0;
    t > 1 ? t = 1;
    bh = t * r_bar_h;
    bh > 0.5 ? (
      gui_c_teal();
      gfx_rect(x1, r_bar_y + r_bar_h - bh, w, bh);
    );
    att = BAND_ATT[i];
    att < -60 ? att = -60;
    att > 0 ? att = 0;
    my = r_bar_y + r_bar_h * (-att / 60);
    att < -0.05 ? (
      gfx_r = 1;
      gfx_g = 140/255;
      gfx_b = 24/255;
      gfx_a = 0.32;
      my - r_bar_y > 0.5 ? gfx_rect(x1, r_bar_y, w, my - r_bar_y);
      gfx_a = 1;
      gui_c_orange();
      gfx_line(x1, my, x1 + w, my, 0);
    );
    i += 1;
  );
  gui_menu == 0 && gui_in(r_bar_x, r_bar_y, r_bar_w, r_bar_h) ? (
    i = gui_band_at(mouse_x);
    x1 = floor(r_bar_x + i * r_bar_w / gui_nb);
    x2 = floor(r_bar_x + (i + 1) * r_bar_w / gui_nb);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.06;
    gfx_rect(x1, r_bar_y, max(1, x2 - x1 - 1), r_bar_h);
    gfx_a = 1;
  );
);
function gui_paint_mid() (
  gui_c_screen();
  gfx_rect(r_disp_x, r_disp_y, r_disp_w, r_disp_h);
  gui_c_line();
  gui_box(r_disp_x, r_disp_y, r_disp_w, r_disp_h);
  gui_paint_bands();
  sprintf(#gui_s, "Bands");
  gui_above_l(r_bnd_x, r_bnd_y);
  sprintf(#gui_s, "%d", gui_nb);
  gui_drop(r_bnd_x, r_bnd_y, r_bnd_w, r_bnd_h, gui_menu == 2);
  sprintf(#gui_s, "Range");
  gui_above_l(r_rl_x, r_rl_y);
  gui_fmt_hz(s_low);
  gui_num(r_rl_x, r_rl_y, r_rl_w, r_rl_h);
  gui_fmt_hz(s_high);
  gui_num(r_rh_x, r_rh_y, r_rh_w, r_rh_h);
  sprintf(#gui_s, "BW");
  gui_above_l(r_bw_x, r_bw_y);
  gui_fmt_pct(s_bw);
  gui_num(r_bw_x, r_bw_y, r_bw_w, r_bw_h);
  s_fmode > 0.5 ? sprintf(#gui_s, "Retro") : sprintf(#gui_s, "Precise");
  gui_above_l(r_fm_x, r_fm_y);
  s_fmode > 0.5 ? sprintf(#gui_s, "Retro") : sprintf(#gui_s, "Precise");
  gui_btn(r_fm_x, r_fm_y, r_fm_w, r_fm_h, s_fmode > 0.5);
  sprintf(#gui_s, "Gate");
  gui_above_l(r_gt_x, r_gt_y);
  gui_fmt_db(s_gate, 0);
  gui_num(r_gt_x, r_gt_y, r_gt_w, r_gt_h);
  sprintf(#gui_s, "Level");
  gui_above_l(r_lv_x, r_lv_y);
  gui_fmt_db(s_level, 1);
  gui_num(r_lv_x, r_lv_y, r_lv_w, r_lv_h);
);
function gui_paint_right() (
  sprintf(#gui_s, "Depth");
  gui_kcap(r_dp_x, r_dp_y, r_dp_r);
  gui_knob(r_dp_x, r_dp_y, r_dp_r, gui_linn(s_depth, 0, 200));
  gui_fmt_pct(s_depth);
  gui_kval(r_dp_x, r_dp_y, r_dp_r);
  sprintf(#gui_s, "Mono");
  gui_btn(r_ch_x, r_ch_y0, r_ch_w, r_ch_h, s_channels < 0.5);
  sprintf(#gui_s, "Stereo");
  gui_btn(r_ch_x, r_ch_y1, r_ch_w, r_ch_h, s_channels >= 0.5 && s_channels < 1.5);
  sprintf(#gui_s, "L/R");
  gui_btn(r_ch_x, r_ch_y2, r_ch_w, r_ch_h, s_channels >= 1.5);
  sprintf(#gui_s, "Attack");
  gui_kcap(r_ak_x, r_ak_y, r_ak_r);
  gui_knob(r_ak_x, r_ak_y, r_ak_r, gui_logn(s_attack, 0.1, 100));
  gui_fmt_ms(s_attack, 0);
  gui_kval(r_ak_x, r_ak_y, r_ak_r);
  sprintf(#gui_s, "Formant");
  gui_kcap(r_fo_x, r_fo_y, r_fo_r);
  gui_knob(r_fo_x, r_fo_y, r_fo_r, gui_linn(s_formant, -12, 12));
  gui_fmt_st(s_formant, 1);
  gui_kval(r_fo_x, r_fo_y, r_fo_r);
  sprintf(#gui_s, "Release");
  gui_kcap(r_re_x, r_re_y, r_re_r);
  gui_knob(r_re_x, r_re_y, r_re_r, gui_logn(s_release, 1, 1000));
  gui_fmt_ms(s_release, 1);
  gui_kval(r_re_x, r_re_y, r_re_r);
  sprintf(#gui_s, "Dry/Wet");
  gui_kcap(r_dw_x, r_dw_y, r_dw_r);
  gui_knob(r_dw_x, r_dw_y, r_dw_r, gui_linn(s_drywet, 0, 100));
  gui_fmt_pct(s_drywet);
  gui_kval(r_dw_x, r_dw_y, r_dw_r);
);
function gui_menu_current(j) (
  gui_menu == 1 ? floor(s_carrier + 0.5) == j : gui_menu == 2 ? floor(s_bands + 0.5) == j : floor(s_wave + 0.5) == j;
);
function gui_menu_label(j) (
  gui_menu == 1 ? gui_name_carrier(j) : gui_menu == 2 ? sprintf(#gui_s, "%d", (j + 1) * 4) : gui_name_wave(j);
);
function gui_paint_menu() local(j, iy, hov, cur) (
  gui_menu <= 0 ? 0 : (
    gui_menu_geom();
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.4;
    gfx_rect(gui_mx + gui_S(2), gui_my + gui_S(3), gui_mw, gui_mn * gui_mih);
    gfx_a = 1;
    gui_c_panel();
    gfx_rect(gui_mx, gui_my, gui_mw, gui_mn * gui_mih);
    gui_c_teal();
    gui_box(gui_mx, gui_my, gui_mw, gui_mn * gui_mih);
    j = 0;
    loop(gui_mn,
      iy = gui_my + j * gui_mih;
      hov = mouse_x >= gui_mx && mouse_x < gui_mx + gui_mw && mouse_y >= iy && mouse_y < iy + gui_mih;
      cur = gui_menu_current(j);
      hov ? (
        gui_c_teal();
        gfx_a = 0.25;
        gfx_rect(gui_mx + 1, iy, gui_mw - 2, gui_mih);
        gfx_a = 1;
      );
      cur ? (
        gui_c_orange();
        gfx_rect(gui_mx + gui_S(2), iy + gui_mih * 0.22, max(2, gui_S(3)), gui_mih * 0.56);
      );
      gui_menu_label(j);
      hov ? gui_c_text() : cur ? gui_c_teal() : gui_c_dim();
      gfx_setfont(1);
      gfx_x = gui_mx + gui_S(8);
      gfx_y = iy;
      gfx_drawstr(#gui_s, 4, gui_mx + gui_mw - gui_S(4), iy + gui_mih);
      j += 1;
    );
  );
);
function gui_paint() (
  gui_paint_bg();
  gui_paint_power();
  gui_paint_left();
  gui_paint_mid();
  gui_paint_right();
  gui_paint_menu();
);

function gui_frame() (
  gfx_dest = -1;
  gfx_mode = 0;
  gfx_a = 1;
  gfx_a2 = 1;
  gui_begin();
  gui_layout();
  gui_input();
  gui_paint();
  gui_prev_cap = mouse_cap;
  gui_prev_x = mouse_x;
  gui_prev_y = mouse_y;
);

gui_frame();

