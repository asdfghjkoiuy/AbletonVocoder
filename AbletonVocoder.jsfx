desc:Ableton Vocoder
// Ableton Live-style channel vocoder.
// No @gfx in this build: REAPER shows the default sliders. The GUI phase
// reads the memory map below; do not move those offsets.

// ---------------------------------------------------------------------------
// Memory map (EEL2 heap indices)
//
//   0 .. 39   BAND_ATT   per-band attenuation in dB. 0 = none.
//                        Clamped to [-60, 0]. Persisted by @serialize
//                        (version word via file_var, then file_mem of these
//                        40 values). Future versions must bump SER_VER.
//  40 .. 79   DISP_ENV   per-band display level: smoothed modulator envelope
//                        in linear amplitude (band RMS), AFTER attenuation
//                        (env_rms * 10^(att_dB/20)).
//                        Mono / Stereo: the mono analysis envelope.
//                        L/R: max(left, right). Not persisted.
//
// DSP workspace starts at 128. GUI code should only touch 0..79.
// ---------------------------------------------------------------------------

slider1:s_carrier=0<0,3,1{Noise,External,Modulator,Pitch Tracking}>Carrier
slider2:s_bands=4<0,9,1{4,8,12,16,20,24,28,32,36,40}>Bands
slider3:s_low=80<20,2000,1>Range Low (Hz)
slider4:s_high=18000<1000,20000,1>Range High (Hz)
slider5:s_bw=100<10,200,1>BW (%)
slider6:s_fmode=0<0,1,1{Precise,Retro}>Filter Mode
slider7:s_gate=-96<-96,0,1>Gate (dB)
slider8:s_level=0<-24,24,0.1>Level (dB)
slider9:s_depth=100<0,200,1>Depth (%)
slider10:s_attack=5<0.1,100,0.1>Attack (ms)
slider11:s_release=80<1,1000,1>Release (ms)
slider12:s_formant=0<-12,12,0.1>Formant (st)
slider13:s_drywet=100<0,100,1>Dry/Wet (%)
slider14:s_channels=1<0,2,1{Mono,Stereo,L/R}>Channels
slider15:s_enhance=0<0,1,1>Enhance
slider16:s_unvoiced=-96<-96,0,1>Unvoiced (dB)
slider17:s_sens=50<0,100,1>Sens (%)
slider18:s_uvspeed=0<0,1,1{Slow,Fast}>Unvoiced Speed
slider19:s_nrate=1<0,1,0.01>Noise Rate
slider20:s_ncrack=1<0,1,0.01>Noise Crackle
slider21:s_wave=0<0,3,1{Saw,Pulse 50%,Pulse 25%,Pulse 12.5%}>Osc Wave
slider22:s_opitch=0<-24,24,1>Osc Pitch (st)
slider23:s_tlow=60<20,1000,1>Track Low (Hz)
slider24:s_thigh=1000<100,2000,1>Track High (Hz)
slider25:s_device=1<0,1,1>Device On

in_pin:Modulator L
in_pin:Modulator R
in_pin:Carrier L (sidechain)
in_pin:Carrier R (sidechain)
out_pin:Output L
out_pin:Output R

@init
SER_VER = 1;
MAXB = 40;
BAND_ATT = 0;
DISP_ENV = 40;

// Per-band coefficient record. Stride 24, base COEF.
//  0 log_fc smoothed (natural log Hz)
//  1 log_fc target
//  2 Q smoothed
//  3 Q target
//  4 retro gain smoothed (linear)
//  5 retro gain target
//  6 flat makeup smoothed (linear, includes alternating-sum normalization)
//  7 flat makeup target
//  8 inv sqrt(noise power gain)   so env_rms * this ~= white-equivalent RMS
//  9 sign (+1 / -1), alternating across the bank
// 10 attenuation smoothed (linear)
// 11 attenuation target (linear)
// 12 a1 13 a2 14 a3 15 k     analysis SVF
// 16 sa1 17 sa2 18 sa3 19 sk synthesis SVF
// 20 band mix 0..1
// 21 center Hz (analysis, smoothed)
COEF = 128;
CSTR = 24;

// Filter state. 4 lanes x MAXB. Stride 8.
// lane 0 analysis L (also mono / stereo modulator)
// lane 1 analysis R (L/R mode)
// lane 2 synthesis L (also mono)
// lane 3 synthesis R
//  0 ic1a 1 ic2a 2 ic1b 3 ic2b
//  4 envelope power (analytic amplitude squared, attack/release smoothed)
//  5 gate gain
//  6 gate open (0/1)
//  7 enhance power (synthesis lanes)
STATE = COEF + MAXB * CSTR;
SSTR = 8;
LANE_AL = 0;
LANE_AR = MAXB;
LANE_SL = MAXB * 2;
LANE_SR = MAXB * 3;
LANE_STEP = MAXB * SSTR;

// Pitch ring (power of two) and YIN scratch. Above the DSP records.
RING = 8192;
RING_SIZE = 4096;
RING_MASK = 4095;
YBUF = RING + RING_SIZE;          // 12288, length 4096
YIN_D = YBUF + 4096;              // 16384, length 4096
// Solver scratch. EEL2 names are case-insensitive: never declare a local
// hr/hi (or garr, smag, ...) in a function that also touches these bases.
GARR = 22000;
SMAG = 22100;                     // up to 48 mags
SR_A = 22200;
SI_A = 22300;
HR = 24000;                       // nfreq * MAXB
HI = 24000 + 48 * MAXB;

PI = 3.141592653589793;
LN2 = 0.6931471805599453;
LN10 = 2.302585092994046;
DB2A = LN10 / 20;
Q_DEN = sqrt(1 + sqrt(2));        // 4th-order -3 dB Q factor
INV_SQRT2 = 0.7071067811865476;

// Depth reference, enhance off: white-equivalent band RMS of -18 dBFS -> gain 1.
// Enhance on: carrier band is normalized to NOMINAL RMS, then multiplied by
// (env_rms / NOMINAL). The two NOMINALs cancel, so a matched carrier/modulator
// reconstructs the analysis filterbank (flat sum ~= unity).
REF_DENS = exp(-18 * DB2A);
INV_REF_DENS = 1 / REF_DENS;
NOMINAL = 0.05;
INV_REF_ENH = 1 / NOMINAL;
GAIN_CAP = 8;
ENH_CAP = 32;
ENH_FLOOR = exp(-80 * DB2A);
WHITE_RMS = 0.20;

// Oscillator scales, each waveform ~ -12 dBFS RMS.
SAW_SCALE = 0.4330127018922193;
P50_SCALE = 0.25;
P25_SCALE = 0.2886751345948129;
P125_SCALE = 0.3779644730092272;

memset(0, 0, HI + 48 * MAXB);

pt_target = 100;
pt_log = log(100);
pt_have = 0;
osc_phase = 0;
boot = 1;
active_carrier = -1;
active_ch = -1;
duck = 1;
duck_target = 1;
design_sig = -1;
uv_env = 0;
formant_sm = 0;
enh_mix = 0;
lvl = 1;
wet = 1;
dev = 1;
n_bands = 20;
n_run = 20;
ring_w = 0;
ring_fill = 0;
hop_count = 0;
dec_i = 0;

function polyblep(t, dt) (
  t < dt ? (
    t /= dt;
    t + t - t * t - 1;
  ) : (
    t > 1 - dt ? (
      t = (t - 1) / dt;
      t * t + t + t + 1;
    ) : 0;
  );
);

function q_of(fc, bw_oct) local(r, fe, oc, oe, qq) global(srate, PI, LN2, Q_DEN) (
  r = exp(bw_oct * 0.5 * LN2);
  fe = fc * r;
  fe > srate * 0.49 ? fe = srate * 0.49;
  oc = tan(PI * fc / srate);
  oe = tan(PI * fe / srate);
  oc < 0.000000000001 ? oc = 0.000000000001;
  r = oe / oc;
  qq = r / (abs(1 - r * r) * Q_DEN + 0.000000000001);
  qq < 0.12 ? qq = 0.12;
  qq > 64 ? qq = 64;
  qq;
);

// Noise power gain of one unity-peak 4th-order band, matched to the quadrature
// envelope (not raw bp variance). Narrow bands: vr = g / (2 Q (1+g^2)), and the
// second-stage lowpass is a true Hilbert partner so the envelope equals RMS.
// Wide / high bands: the lowpass is heavier than the bandpass, so the envelope
// reads hot. Integrate (|Hbp|^4 + |Hbp|^2 |k Lp|^2) / 2, which is what
// sqrt(smoothed(bp^2+(k*lp)^2)/2) reports for white noise.
function h4_det(freq, fc, qq) local(g, k, w, den, num) global(srate, PI) (
  g = tan(PI * fc / srate);
  g < 0.000000000001 ? g = 0.000000000001;
  k = 1 / qq;
  w = tan(PI * min(freq, srate * 0.499) / srate) / g;
  den = (1 - w * w);
  den = den * den + (k * w) * (k * w);
  den < 0.000000000000000001 ? den = 0.000000000000000001;
  num = k * k * w;
  num = num * num * (1 + w * w) / (2 * den * den);
  num;
);

function band_vr(fc, qq) local(g, vr, n, i, f1, f2, f, p, prev_f, prev_p, step) global(srate, PI) (
  g = tan(PI * min(fc, srate * 0.45) / srate);
  vr = g / (2 * qq * (1 + g * g));
  (qq >= 1.2 && fc < srate * 0.12) ? vr : (
    n = 72;
    f1 = max(fc / 32, 1);
    f2 = min(fc * 32, srate * 0.49);
    f2 <= f1 ? vr : (
      step = log(f2 / f1) / (n - 1);
      prev_f = f1;
      prev_p = h4_det(f1, fc, qq);
      vr = 0;
      i = 1;
      loop(n - 1,
        f = f1 * exp(step * i);
        p = h4_det(f, fc, qq);
        vr += (prev_p + p) * 0.5 * (f - prev_f);
        prev_f = f;
        prev_p = p;
        i += 1;
      );
      vr = 2 * vr / srate;
      vr < 0.0000000001 ? 0.0000000001 : vr;
    );
  );
);

function svf_set(fc, qq) local(g, kk) global(o_a1, o_a2, o_a3, o_k, srate, PI) (
  fc < 1 ? fc = 1;
  fc > srate * 0.45 ? fc = srate * 0.45;
  qq < 0.12 ? qq = 0.12;
  g = tan(PI * fc / srate);
  kk = 1 / qq;
  o_a1 = 1 / (1 + g * (g + kk));
  o_a2 = g * o_a1;
  o_a3 = g * o_a2;
  o_k = kk;
);

function bp4_ri(freq, fc, qq) local(g, k, w, dr, di, ni, den, pr, pj)
global(h_re, h_im, srate, PI) (
  g = tan(PI * min(fc, srate * 0.45) / srate);
  g < 0.000000000001 ? g = 0.000000000001;
  k = 1 / max(qq, 0.12);
  w = tan(PI * min(freq, srate * 0.499) / srate) / g;
  dr = 1 - w * w;
  di = k * w;
  ni = k * w;
  den = dr * dr + di * di;
  den < 0.000000000000000001 ? den = 0.000000000000000001;
  pr = (ni * di) / den;
  pj = (ni * dr) / den;
  h_re = pr * pr - pj * pj;
  h_im = 2 * pr * pj;
);

function median_buf(buf, n) local(i, j, key) (
  i = 1;
  loop(max(n - 1, 0),
    key = buf[i];
    j = i - 1;
    while (j >= 0 && buf[j] > key) (
      buf[j + 1] = buf[j];
      j -= 1;
    );
    buf[j + 1] = key;
    i += 1;
  );
  n < 2 ? buf[0] : ((buf[n / 2 - 1] + buf[n / 2]) * 0.5);
);

// Alternating-polarity makeup so |sum sign_i * g_i * H_i| ~= 1 across the bank.
function solve_flat() local(nfreq, fmin, fmax, log0, log1, fi, bi, freq, idx, sgn, acc_r, acc_i, mag, med, tr, ti, num, den, gn, xr, xi, cf) global(srate, flo, fhi, n_bands, COEF, CSTR, MAXB, HR, HI, GARR, SMAG, SR_A, SI_A, h_re, h_im) (
  nfreq = 36;
  fmin = flo * 1.25;
  fmax = fhi * 0.8;
  fmax > srate * 0.45 ? fmax = srate * 0.45;
  (n_bands < 2 || fmax <= fmin * 1.02) ? (
    bi = 0;
    loop(n_bands,
      (COEF + bi * CSTR)[7] = 1;
      bi += 1;
    );
  ) : (
    log0 = log(fmin);
    log1 = log(fmax);
    fi = 0;
    loop(nfreq,
      freq = exp(log0 + (log1 - log0) * fi / (nfreq - 1));
      bi = 0;
      loop(n_bands,
        cf = COEF + bi * CSTR;
        bp4_ri(freq, exp(cf[1]), cf[3]);
        sgn = cf[9];
        idx = fi * MAXB + bi;
        HR[idx] = h_re * sgn;
        HI[idx] = h_im * sgn;
        bi += 1;
      );
      fi += 1;
    );
    bi = 0;
    loop(n_bands, GARR[bi] = 1; bi += 1;);
    loop(4,
      fi = 0;
      loop(nfreq,
        acc_r = 0;
        acc_i = 0;
        bi = 0;
        loop(n_bands,
          idx = fi * MAXB + bi;
          acc_r += HR[idx] * GARR[bi];
          acc_i += HI[idx] * GARR[bi];
          bi += 1;
        );
        SR_A[fi] = acc_r;
        SI_A[fi] = acc_i;
        SMAG[fi] = sqrt(acc_r * acc_r + acc_i * acc_i) + 0.000000000001;
        fi += 1;
      );
      med = median_buf(SMAG, nfreq);
      bi = 0;
      loop(n_bands,
        num = 0;
        den = 0;
        fi = 0;
        loop(nfreq,
          idx = fi * MAXB + bi;
          xr = HR[idx];
          xi = HI[idx];
          mag = sqrt(SR_A[fi] * SR_A[fi] + SI_A[fi] * SI_A[fi]) + 0.000000000001;
          tr = med * SR_A[fi] / mag - SR_A[fi] + GARR[bi] * xr;
          ti = med * SI_A[fi] / mag - SI_A[fi] + GARR[bi] * xi;
          num += xr * tr + xi * ti;
          den += xr * xr + xi * xi;
          fi += 1;
        );
        den < 0.0000000001 ? den = 0.0000000001;
        gn = num / den;
        gn = 0.55 * GARR[bi] + 0.45 * gn;
        gn < 0.2 ? gn = 0.2;
        gn > 5 ? gn = 5;
        GARR[bi] = gn;
        bi += 1;
      );
    );
    fi = 0;
    loop(nfreq,
      acc_r = 0;
      acc_i = 0;
      bi = 0;
      loop(n_bands,
        idx = fi * MAXB + bi;
        acc_r += HR[idx] * GARR[bi];
        acc_i += HI[idx] * GARR[bi];
        bi += 1;
      );
      SMAG[fi] = sqrt(acc_r * acc_r + acc_i * acc_i) + 0.000000000001;
      fi += 1;
    );
    med = median_buf(SMAG, nfreq);
    med < 0.0001 ? med = 1;
    bi = 0;
    loop(n_bands,
      (COEF + bi * CSTR)[7] = GARR[bi] / med;
      bi += 1;
    );
  );
);

function design_targets() local(bi, cf, t, span, fc, qq, qm, vr, bw_oct) global(srate, flo, fhi, n_bands, bw_pct, retro_on, COEF, CSTR, MAXB, LN2, DB2A) (
  flo < 20 ? flo = 20;
  fhi > srate * 0.45 ? fhi = srate * 0.45;
  fhi < flo * 1.25 ? fhi = min(flo * 1.25, srate * 0.45);
  fhi <= flo ? fhi = min(flo * 2, srate * 0.45);
  span = log(fhi / flo);
  n_bands > 1 ? (bw_oct = (span / LN2) / (n_bands - 1) * (bw_pct / 100);) : (bw_oct = 1;);
  bw_oct < 0.02 ? bw_oct = 0.02;
  bi = 0;
  loop(MAXB,
    cf = COEF + bi * CSTR;
    bi < n_bands ? (
      n_bands > 1 ? t = bi / (n_bands - 1) : t = 0;
      fc = exp(log(flo) + span * (n_bands > 1 ? bi / (n_bands - 1) : 0.5));
      fc > srate * 0.45 ? fc = srate * 0.45;
      qq = q_of(fc, bw_oct);
      retro_on ? (
        qm = 1 + t * 1.5;
        qq *= qm;
        qq > 64 ? qq = 64;
        cf[5] = exp(t * 6 * DB2A);
      ) : (
        cf[5] = 1;
      );
      cf[1] = log(fc);
      cf[3] = qq;
      cf[9] = (bi % 2) ? -1 : 1;
      vr = band_vr(fc, qq);
      vr < 0.0000000001 ? vr = 0.0000000001;
      cf[8] = 1 / sqrt(vr);
      cf[21] = fc;
    ) : (
      cf[1] = log(max(flo, 20));
      cf[3] = 1;
      cf[5] = 1;
      cf[7] = 0;
      cf[8] = 1;
      cf[9] = 1;
      cf[21] = flo;
    );
    bi += 1;
  );
  solve_flat();
);

function smooth_coeffs() local(bi, cf, a, fc, fcs, qq, qq_s, amix, form_ratio) global(o_a1, o_a2, o_a3, o_k, srate, samplesblock, boot, formant_sm, s_formant, LN2, COEF, CSTR, MAXB, n_bands) (
  a = 1 - exp(-samplesblock / (0.02 * srate));
  a > 1 ? a = 1;
  boot ? formant_sm = s_formant : (
    formant_sm += (1 - exp(-samplesblock / (0.012 * srate))) * (s_formant - formant_sm);
  );
  form_ratio = exp(formant_sm * LN2 / 12);
  bi = 0;
  loop(MAXB,
    cf = COEF + bi * CSTR;
    boot ? (
      cf[0] = cf[1];
      cf[2] = cf[3];
      cf[4] = cf[5];
      cf[6] = cf[7];
      amix = bi < n_bands ? 1 : 0;
      cf[20] = amix;
    ) : (
      cf[0] += a * (cf[1] - cf[0]);
      cf[2] += a * (cf[3] - cf[2]);
      cf[4] += a * (cf[5] - cf[4]);
      cf[6] += a * (cf[7] - cf[6]);
    );
    fc = exp(cf[0]);
    qq = cf[2];
    qq < 0.12 ? qq = 0.12;
    svf_set(fc, qq);
    cf[12] = o_a1; cf[13] = o_a2; cf[14] = o_a3; cf[15] = o_k;
    fcs = fc * form_ratio;
    fcs > srate * 0.45 ? fcs = srate * 0.45;
    fcs < 1 ? fcs = 1;
    // A pure center shift of only a few semitones still overlaps the original
    // band (BW 100% is ~5 st wide). Tighten the carrier filters as the shift
    // grows so the moved slice, not the original carrier spectrum, sets the
    // output envelope.
    qq_s = qq * (1 + abs(formant_sm) * 0.40);
    qq_s > 48 ? qq_s = 48;
    svf_set(fcs, qq_s);
    cf[16] = o_a1; cf[17] = o_a2; cf[18] = o_a3; cf[19] = o_k;
    cf[21] = fc;
    bi < n_bands ? 0 : 0;
    bi += 1;
  );
);

// Two cascaded unity-peak TPT bandpasses. Coeffs are c_a1..c_k.
// Returns stage-2 bandpass. Sets env_a2 = bp^2 + (k*lp)^2 (peak^2 at fc).
function svf2(st, x) local(ic1, ic2, v3, v1, v2, bp)
global(c_a1, c_a2, c_a3, c_k, env_a2) (
  ic1 = st[0];
  ic2 = st[1];
  v3 = x - ic2;
  v1 = c_a1 * ic1 + c_a2 * v3;
  v2 = ic2 + c_a2 * ic1 + c_a3 * v3;
  st[0] = v1 + v1 - ic1;
  st[1] = v2 + v2 - ic2;
  bp = c_k * v1;
  ic1 = st[2];
  ic2 = st[3];
  v3 = bp - ic2;
  v1 = c_a1 * ic1 + c_a2 * v3;
  v2 = ic2 + c_a2 * ic1 + c_a3 * v3;
  st[2] = v1 + v1 - ic1;
  st[3] = v2 + v2 - ic2;
  bp = c_k * v1;
  env_a2 = bp * bp + (c_k * v2) * (c_k * v2);
  bp;
);

function env_follow(st, a2) local(ep) global(att_c, rel_c) (
  ep = st[4];
  a2 > ep ? (ep += att_c * (a2 - ep);) : (ep += rel_c * (a2 - ep););
  ep < 0.000000000000000000000001 ? ep = 0;
  st[4] = ep;
  ep > 0 ? sqrt(ep * 0.5) : 0;
);

function gate_follow(st, env) local(op, gg) global(gate_off, gate_open_th, gate_close_th, gate_c) (
  gate_off ? (
    st[6] = 1;
    st[5] = 1;
    1;
  ) : (
    op = st[6];
    op > 0.5 ? (env < gate_close_th ? op = 0;) : (env >= gate_open_th ? op = 1;);
    st[6] = op;
    gg = st[5];
    gg += gate_c * (op - gg);
    gg < 0.0000001 ? gg = 0;
    st[5] = gg;
    gg;
  );
);

function depth_gain(env, inv_vr) local(go, gn, b) global(depth_mode, INV_REF_DENS, INV_REF_ENH, depth_k, GAIN_CAP, enh_mix) (
  depth_mode == 0 ? (
    go = 1;
    gn = 1;
  ) : depth_mode == 1 ? (
    go = env * inv_vr * INV_REF_DENS;
    gn = env * INV_REF_ENH;
  ) : (
    env < 0.0000000001 ? (
      go = 0;
      gn = 0;
    ) : (
      b = env * inv_vr * INV_REF_DENS;
      b < 0.00000001 ? b = 0.00000001;
      go = exp(depth_k * log(b));
      b = env * INV_REF_ENH;
      b < 0.00000001 ? b = 0.00000001;
      gn = exp(depth_k * log(b));
    );
  );
  go > GAIN_CAP ? go = GAIN_CAP;
  gn > GAIN_CAP ? gn = GAIN_CAP;
  go < 0 ? go = 0;
  gn < 0 ? gn = 0;
  go * (1 - enh_mix) + gn * enh_mix;
);

function synth_sample(st, x) local(y, yp, hp, rms, boost) global(enh_mix, enh_att, enh_rel, NOMINAL, ENH_FLOOR, ENH_CAP) (
  y = svf2(st, x);
  enh_mix > 0.0005 ? (
    yp = y * y;
    hp = st[7];
    yp > hp ? (hp += enh_att * (yp - hp);) : (hp += enh_rel * (yp - hp););
    hp < 0.000000000000000000000001 ? hp = 0;
    st[7] = hp;
    rms = hp > 0 ? sqrt(hp) : 0;
    rms < ENH_FLOOR ? rms = ENH_FLOOR;
    boost = NOMINAL / rms;
    boost > ENH_CAP ? boost = ENH_CAP;
    y *= (1 - enh_mix + enh_mix * boost);
  );
  y;
);

function yin_run() local(frame, w, tau_min, tau_max, start, j, tau, xj, xt, s1, s2, rr, dd, acc, cm, best, bestv, found, a, b, c, denom, tau_f, f0, mean, energy, idx) global(sr_dec, tlow_hz, thigh_hz, ring_fill, ring_w, RING_SIZE, RING, YBUF, YIN_D, yin_gate2, pt_target, pt_have) (
  tau_max = floor(sr_dec / max(tlow_hz, 20));
  tau_max < 8 ? tau_max = 8;
  tau_max > 1500 ? tau_max = 1500;
  tau_min = floor(sr_dec / max(thigh_hz, tlow_hz + 1));
  tau_min < 2 ? tau_min = 2;
  tau_min >= tau_max - 2 ? tau_min = max(2, tau_max - 4);
  w = tau_max + 2;
  frame = w + w;
  ring_fill < frame ? 0 : (
    start = ring_w - frame;
    start < 0 ? start += RING_SIZE;
    mean = 0;
    j = 0;
    loop(frame,
      idx = start + j;
      idx >= RING_SIZE ? idx -= RING_SIZE;
      YBUF[j] = RING[idx];
      mean += YBUF[j];
      j += 1;
    );
    mean /= frame;
    energy = 0;
    j = 0;
    loop(frame,
      YBUF[j] -= mean;
      energy += YBUF[j] * YBUF[j];
      j += 1;
    );
    energy < yin_gate2 * frame ? 0 : (
      s1 = 0;
      j = 0;
      loop(w,
        s1 += YBUF[j] * YBUF[j];
        j += 1;
      );
      acc = 0;
      YIN_D[0] = 1;
      best = tau_min;
      bestv = 1000000000;
      found = 0;
      tau = 1;
      loop(tau_max,
        s2 = 0;
        rr = 0;
        j = 0;
        loop(w,
          xj = YBUF[j];
          xt = YBUF[j + tau];
          s2 += xt * xt;
          rr += xj * xt;
          j += 1;
        );
        dd = s1 + s2 - 2 * rr;
        dd < 0 ? dd = 0;
        acc += dd;
        cm = acc > 0 ? (dd * tau / acc) : 1;
        YIN_D[tau] = cm;
        tau >= tau_min && cm < bestv ? (
          bestv = cm;
          best = tau;
        );
        tau += 1;
      );
      // One extra lag so parabolic interpolation can look at tau+1.
      s2 = 0;
      rr = 0;
      j = 0;
      tau = tau_max + 1;
      loop(w,
        xj = YBUF[j];
        xt = YBUF[j + tau];
        s2 += xt * xt;
        rr += xj * xt;
        j += 1;
      );
      dd = s1 + s2 - 2 * rr;
      dd < 0 ? dd = 0;
      acc += dd;
      YIN_D[tau] = acc > 0 ? (dd * tau / acc) : 1;
      // Smallest lag under the threshold, then walk to the local minimum.
      tau = tau_min;
      found = 0;
      while (tau < tau_max && !found) (
        YIN_D[tau] < 0.15 ? found = 1 : (tau += 1;);
      );
      found ? (
        while (tau + 1 < tau_max && YIN_D[tau + 1] < YIN_D[tau]) (tau += 1;);
      ) : (
        bestv > 0.40 ? tau = 0 : tau = best;
      );
      tau > 1 ? (
        a = YIN_D[tau - 1];
        b = YIN_D[tau];
        c = YIN_D[tau + 1];
        denom = a - 2 * b + c;
        tau_f = denom != 0 ? (tau + 0.5 * (a - c) / denom) : tau;
        tau_f < 1 ? tau_f = tau;
        f0 = sr_dec / tau_f;
        f0 < tlow_hz ? f0 = tlow_hz;
        f0 > thigh_hz ? f0 = thigh_hz;
        pt_target = f0;
        pt_have = 1;
      );
    );
  );
);

@slider
param_dirty = 1;

@block
n_tgt = (s_bands + 1) * 4;
n_tgt < 4 ? n_tgt = 4;
n_tgt > 40 ? n_tgt = 40;
bw_pct = s_bw;
bw_pct < 10 ? bw_pct = 10;
bw_pct > 200 ? bw_pct = 200;
flo = s_low;
fhi = s_high;
retro_on = s_fmode > 0.5;

sig = n_tgt * 100000 + floor(flo) + floor(fhi) * 0.001 + bw_pct * 17 + retro_on * 333 + floor(srate);
sig != design_sig ? (
  n_bands = n_tgt;
  design_targets();
  design_sig = sig;
  param_dirty = 1;
);

// Snap the smoothed design the first time through so tests are not a fade-in.
smooth_coeffs();
boot ? (
  lvl = exp(s_level * DB2A);
  wet = max(0, min(1, s_drywet * 0.01));
  dev = s_device > 0.5;
  enh_mix = s_enhance > 0.5;
  formant_sm = s_formant;
  active_carrier = s_carrier;
  active_ch = s_channels;
  duck = 1;
  duck_target = 1;
  pending_route = 0;
  gi = 0;
  loop(MAXB * 4,
    (STATE + gi * SSTR)[5] = 1;
    (STATE + gi * SSTR)[6] = 1;
    gi += 1;
  );
);
boot = 0;

bi = 0;
loop(MAXB,
  cf = COEF + bi * CSTR;
  ad = BAND_ATT[bi];
  ad < -60 ? ad = -60;
  ad > 0 ? ad = 0;
  BAND_ATT[bi] = ad;
  cf[11] = exp(ad * DB2A);
  bi += 1;
);

att_c = 1 - exp(-1 / (max(s_attack, 0.05) * 0.001 * srate));
rel_c = 1 - exp(-1 / (max(s_release, 0.2) * 0.001 * srate));
att_c > 1 ? att_c = 1;
rel_c > 1 ? rel_c = 1;
enh_att = 1 - exp(-1 / (0.004 * srate));
enh_rel = 1 - exp(-1 / (0.050 * srate));
gate_c = 1 - exp(-1 / (0.004 * srate));
duck_c = 1 - exp(-1 / (0.0035 * srate));
macro_c = 1 - exp(-1 / (0.008 * srate));
bmix_c = 1 - exp(-1 / (0.012 * srate));
att_sm_c = 1 - exp(-1 / (0.008 * srate));
// Release is shorter than the attack. A 30 ms hangover still covers the next
// 20 ms test frame and the power-mean HF metric treats that as a voiced hit.
uv_ms_a = s_uvspeed > 0.5 ? 0.004 : 0.012;
uv_ms_r = s_uvspeed > 0.5 ? 0.0025 : 0.004;
uv_att = 1 - exp(-1 / (uv_ms_a * srate));
uv_rel = 1 - exp(-1 / (uv_ms_r * srate));
glide_c = 1 - exp(-1 / (0.0025 * srate));
lvl_target = exp(max(-24, min(24, s_level)) * DB2A);
wet_target = max(0, min(1, s_drywet * 0.01));
dev_target = s_device > 0.5;
enh_target = s_enhance > 0.5;

depth_sm = s_depth;
abs(s_depth - 100) < 0.01 ? depth_mode = 1 : (
  s_depth < 0.01 ? depth_mode = 0 : (
    depth_mode = 2;
    depth_k = s_depth * 0.01;
  );
);

gate_off = s_gate <= -95.5;
gate_open_th = exp(max(s_gate, -96) * DB2A);
gate_close_th = exp((max(s_gate, -96) - 3) * DB2A);

uv_off = (s_unvoiced <= -95.5 || s_sens <= 0);
uv_lin = uv_off ? 0 : exp(s_unvoiced * DB2A);
uv_thr = (100 - max(0, min(100, s_sens))) * 0.0084;
uv_energy_lin = exp(-46 * DB2A);

// Route changes duck the wet path, then swap, so the carrier discontinuity
// lands while the wet gain is ~0.
route_changed = (s_carrier != active_carrier || s_channels != active_ch);
route_changed ? (
  pending_route = 1;
  duck_target = 0;
) : (
  pending_route && duck < 0.02 ? (
    active_carrier = s_carrier;
    active_ch = s_channels;
    pending_route = 0;
    duck_target = 1;
  ) : (
    !pending_route ? duck_target = 1;
  );
);

// Noise sample-and-hold rate. 0 -> 300 Hz, 1 -> full rate, exponential.
nrate = max(0, min(1, s_nrate));
rate_hz = 300 * exp(nrate * log(srate / 300));
hold_n = srate / rate_hz;
hold_n < 1 ? hold_n = 1;

// Pitch decimator ~8-12 kHz, 4th-order lowpass, hop 4 ms.
decim = 2;
while ((srate / decim) > 12000) (decim += 1;);
sr_dec = srate / decim;
lp_fc = min(4200, 0.40 * sr_dec);
svf_set(lp_fc, 0.7071);
lp_a1 = o_a1; lp_a2 = o_a2; lp_a3 = o_a3; lp_k = o_k;
hop_n = floor(0.004 * sr_dec);
hop_n < 16 ? hop_n = 16;
tlow_hz = max(20, min(s_tlow, 1000));
thigh_hz = max(tlow_hz + 10, min(s_thigh, 2000));
yin_gate2 = exp(-50 * DB2A);
yin_gate2 *= yin_gate2;
pt_transpose = exp(max(-24, min(24, s_opitch)) * LN2 / 12);

n_run = n_bands;
bi = n_bands;
while (bi < MAXB && (COEF + bi * CSTR)[20] > 0.001) (bi += 1;);
n_run = bi;
// Coherent-sum normalization is slightly quieter as bands are added.
// 0.40 dB per octave of (N/20) keeps speech+saw RMS within the T5 window.
n_trim = exp(0.40 * log(n_bands / 20) / LN2 * DB2A);

@sample
duck += duck_c * (duck_target - duck);
lvl += macro_c * (lvl_target - lvl);
wet += macro_c * (wet_target - wet);
dev += macro_c * (dev_target - dev);
enh_mix += macro_c * (enh_target - enh_mix);
duck < 0 ? duck = 0;
duck > 1 ? duck = 1;

inL = spl0;
inR = spl1;

// Carrier.
active_carrier == 0 ? (
  sh_pos += 1;
  sh_pos >= hold_n ? (
    sh_pos -= hold_n;
    s_ncrack >= 0.999 ? (
      sh_l = (rand(2) - 1) * 0.3464101615;
      sh_r = (rand(2) - 1) * 0.3464101615;
    ) : (
      crack_p = s_ncrack * s_ncrack;
      crack_p = crack_p * crack_p;
      crack_p < 0.0008 ? crack_p = 0.0008;
      crack_a = WHITE_RMS / sqrt(crack_p);
      crack_a > 4 ? crack_a = 4;
      sh_l = rand(1) < crack_p ? (rand(1) < 0.5 ? crack_a : -crack_a) : 0;
      sh_r = rand(1) < crack_p ? (rand(1) < 0.5 ? crack_a : -crack_a) : 0;
    );
  );
  carL = sh_l;
  carR = sh_r;
) : active_carrier == 1 ? (
  carL = spl2;
  carR = spl3;
) : active_carrier == 2 ? (
  carL = inL;
  carR = inR;
) : (
  pt_log += glide_c * (log(max(pt_target, 1)) - pt_log);
  osc_dt = exp(pt_log) * pt_transpose / srate;
  osc_dt > 0.45 ? osc_dt = 0.45;
  osc_dt < 0 ? osc_dt = 0;
  osc_phase += osc_dt;
  osc_phase >= 1 ? osc_phase -= 1;
  s_wave < 0.5 ? (
    osc = (2 * osc_phase - 1) - polyblep(osc_phase, osc_dt);
    osc *= SAW_SCALE;
  ) : (
    s_wave < 1.5 ? pw = 0.5 : s_wave < 2.5 ? pw = 0.25 : pw = 0.125;
    osc = osc_phase < pw ? 1 : -1;
    osc += polyblep(osc_phase, osc_dt);
    ph2 = osc_phase + 1 - pw;
    ph2 >= 1 ? ph2 -= 1;
    osc -= polyblep(ph2, osc_dt);
    osc -= (pw + pw - 1);
    s_wave < 1.5 ? osc *= P50_SCALE : s_wave < 2.5 ? osc *= P25_SCALE : osc *= P125_SCALE;
  );
  carL = osc;
  carR = osc;
);

active_ch == 0 ? (
  carM = (carL + carR) * 0.5;
  carL = carM;
  carR = carM;
  modL = (inL + inR) * 0.5;
  modR = modL;
) : active_ch == 1 ? (
  modL = (inL + inR) * 0.5;
  modR = modL;
) : (
  modL = inL;
  modR = inR;
);

// Unvoiced noise is added to the carrier, then shaped by the synthesis bank
// and the modulator envelopes. Sens 0 and Unvoiced -96 stay exactly off.
uv_amp = 0;
uv_off ? (
  uv_env = 0;
) : (
  uv_amp = uv_env * uv_lin * 0.17;
);
uv_amp > 0.00000001 ? (
  carL += (rand(2) - 1) * uv_amp;
  carR += (rand(2) - 1) * uv_amp;
);

sumL = 0;
sumR = 0;
e_all = 0;
e_hi = 0;
unity_dg = depth_mode < 0.5;
fast_enh = depth_mode > 0.5 && depth_mode < 1.5 && enh_mix > 0.999;
fast_dry = depth_mode > 0.5 && depth_mode < 1.5 && enh_mix < 0.001;
do_enh = enh_mix > 0.0005;
ch_mono = active_ch < 0.5;
ch_lr = active_ch > 1.5;
bi = 0;
loop(n_run,
  cf = COEF + bi * CSTR;
  bm = cf[20];
  bm += bmix_c * ((bi < n_bands) - bm);
  cf[20] = bm;
  at = cf[10];
  at += att_sm_c * (cf[11] - at);
  at < 0.000000000001 ? at = 0;
  cf[10] = at;
  trim = cf[9] * cf[6] * cf[4] * at * bm * n_trim;
  fc_hz = cf[21];
  invr = cf[8];

  b_a1 = cf[12];
  b_a2 = cf[13];
  b_a3 = cf[14];
  b_k = cf[15];
  stA = STATE + bi * SSTR;

  p_ic1 = stA[0];
  p_ic2 = stA[1];
  p_v3 = modL - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stA[0] = p_v1 + p_v1 - p_ic1;
  stA[1] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_ic1 = stA[2];
  p_ic2 = stA[3];
  p_v3 = p_bp - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stA[2] = p_v1 + p_v1 - p_ic1;
  stA[3] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_v3 = b_k * p_v2;
  p_a2 = p_bp * p_bp + p_v3 * p_v3;
  p_ep = stA[4];
  p_a2 > p_ep ? (p_ep += att_c * (p_a2 - p_ep);) : (p_ep += rel_c * (p_a2 - p_ep););
  p_ep < 0.000000000000000000000001 ? p_ep = 0;
  stA[4] = p_ep;
  envL = p_ep > 0 ? sqrt(p_ep * 0.5) : 0;
  // Instantaneous band power for the unvoiced ratio. The synthesis envelope
  // release is up to 450 ms, which would still read "fricative" through the
  // next vowel. The decision itself is smoothed later (Slow/Fast).
  instL = p_a2;
  gate_off ? (
    p_gg = stA[5];
    p_gg < 0.999 ? (
      p_gg += gate_c * (1 - p_gg);
      p_gg > 0.999 ? p_gg = 1;
      stA[5] = p_gg;
      stA[6] = 1;
    ) : p_gg = 1;
  ) : (
    p_op = stA[6];
    p_op > 0.5 ? (envL < gate_close_th ? p_op = 0;) : (envL >= gate_open_th ? p_op = 1;);
    stA[6] = p_op;
    p_gg = stA[5];
    p_gg += gate_c * (p_op - p_gg);
    p_gg < 0.0000001 ? p_gg = 0;
    stA[5] = p_gg;
  );
  gLgate = p_gg;

  ch_lr ? (
    stB = stA + LANE_STEP;
    p_ic1 = stB[0];
    p_ic2 = stB[1];
    p_v3 = modR - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stB[0] = p_v1 + p_v1 - p_ic1;
    stB[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stB[2];
    p_ic2 = stB[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stB[2] = p_v1 + p_v1 - p_ic1;
    stB[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_v3 = b_k * p_v2;
    p_a2 = p_bp * p_bp + p_v3 * p_v3;
    p_ep = stB[4];
    p_a2 > p_ep ? (p_ep += att_c * (p_a2 - p_ep);) : (p_ep += rel_c * (p_a2 - p_ep););
    p_ep < 0.000000000000000000000001 ? p_ep = 0;
    stB[4] = p_ep;
    envR = p_ep > 0 ? sqrt(p_ep * 0.5) : 0;
    instR = p_a2;
    gate_off ? (
      p_gg = stB[5];
      p_gg < 0.999 ? (
        p_gg += gate_c * (1 - p_gg);
        p_gg > 0.999 ? p_gg = 1;
        stB[5] = p_gg;
        stB[6] = 1;
      ) : p_gg = 1;
    ) : (
      p_op = stB[6];
      p_op > 0.5 ? (envR < gate_close_th ? p_op = 0;) : (envR >= gate_open_th ? p_op = 1;);
      stB[6] = p_op;
      p_gg = stB[5];
      p_gg += gate_c * (p_op - p_gg);
      p_gg < 0.0000001 ? p_gg = 0;
      stB[5] = p_gg;
    );
    gRgate = p_gg;
    e_all += instL + instR;
    fc_hz >= 4000 ? e_hi += instL + instR;
    disp = envL > envR ? envL : envR;
  ) : (
    envR = envL;
    gRgate = gLgate;
    e_all += instL;
    fc_hz >= 4000 ? e_hi += instL;
    disp = envL;
  );
  DISP_ENV[bi] = disp * at;

  unity_dg ? (
    dgL = 1;
    dgR = 1;
  ) : fast_enh ? (
    dgL = envL * INV_REF_ENH;
    dgL > GAIN_CAP ? dgL = GAIN_CAP;
    ch_lr ? (
      dgR = envR * INV_REF_ENH;
      dgR > GAIN_CAP ? dgR = GAIN_CAP;
    ) : (
      dgR = dgL;
    );
  ) : fast_dry ? (
    dgL = envL * invr * INV_REF_DENS;
    dgL > GAIN_CAP ? dgL = GAIN_CAP;
    ch_lr ? (
      dgR = envR * invr * INV_REF_DENS;
      dgR > GAIN_CAP ? dgR = GAIN_CAP;
    ) : (
      dgR = dgL;
    );
  ) : (
    dgL = depth_gain(envL, invr);
    ch_lr ? dgR = depth_gain(envR, invr) : dgR = dgL;
  );

  b_a1 = cf[16];
  b_a2 = cf[17];
  b_a3 = cf[18];
  b_k = cf[19];
  stS = stA + LANE_STEP * 2;

  p_ic1 = stS[0];
  p_ic2 = stS[1];
  p_v3 = carL - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stS[0] = p_v1 + p_v1 - p_ic1;
  stS[1] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  p_ic1 = stS[2];
  p_ic2 = stS[3];
  p_v3 = p_bp - p_ic2;
  p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
  p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
  stS[2] = p_v1 + p_v1 - p_ic1;
  stS[3] = p_v2 + p_v2 - p_ic2;
  p_bp = b_k * p_v1;
  do_enh ? (
    p_a2 = p_bp * p_bp;
    p_ep = stS[7];
    p_a2 > p_ep ? (p_ep += enh_att * (p_a2 - p_ep);) : (p_ep += enh_rel * (p_a2 - p_ep););
    p_ep < 0.000000000000000000000001 ? p_ep = 0;
    stS[7] = p_ep;
    p_rms = p_ep > 0 ? sqrt(p_ep) : 0;
    p_rms < ENH_FLOOR ? p_rms = ENH_FLOOR;
    p_boost = NOMINAL / p_rms;
    p_boost > ENH_CAP ? p_boost = ENH_CAP;
    p_bp *= enh_mix > 0.999 ? p_boost : (1 - enh_mix + enh_mix * p_boost);
  );
  sumL += p_bp * dgL * gLgate * trim;

  ch_mono ? 0 : (
    stT = stS + LANE_STEP;
    p_ic1 = stT[0];
    p_ic2 = stT[1];
    p_v3 = carR - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stT[0] = p_v1 + p_v1 - p_ic1;
    stT[1] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    p_ic1 = stT[2];
    p_ic2 = stT[3];
    p_v3 = p_bp - p_ic2;
    p_v1 = b_a1 * p_ic1 + b_a2 * p_v3;
    p_v2 = p_ic2 + b_a2 * p_ic1 + b_a3 * p_v3;
    stT[2] = p_v1 + p_v1 - p_ic1;
    stT[3] = p_v2 + p_v2 - p_ic2;
    p_bp = b_k * p_v1;
    do_enh ? (
      p_a2 = p_bp * p_bp;
      p_ep = stT[7];
      p_a2 > p_ep ? (p_ep += enh_att * (p_a2 - p_ep);) : (p_ep += enh_rel * (p_a2 - p_ep););
      p_ep < 0.000000000000000000000001 ? p_ep = 0;
      stT[7] = p_ep;
      p_rms = p_ep > 0 ? sqrt(p_ep) : 0;
      p_rms < ENH_FLOOR ? p_rms = ENH_FLOOR;
      p_boost = NOMINAL / p_rms;
      p_boost > ENH_CAP ? p_boost = ENH_CAP;
      p_bp *= enh_mix > 0.999 ? p_boost : (1 - enh_mix + enh_mix * p_boost);
    );
    sumR += p_bp * dgR * gRgate * trim;
  );
  bi += 1;
);

bi = n_run;
loop(MAXB - n_run,
  DISP_ENV[bi] = 0;
  bi += 1;
);

// Unvoiced detector from this sample's band energies. Level-independent ratio,
// plus an energy gate so silence is not fricative. Sens 100 forces the noise
// on whenever the modulator is above the energy gate.
uv_off ? (
  uv_env = 0;
) : (
  e_all > 0.0000000000000001 ? (
    total_rms = sqrt(e_all);
    hf_frac = e_hi / e_all;
  ) : (
    total_rms = 0;
    hf_frac = 0;
  );
  energy_ok = total_rms > uv_energy_lin;
  s_sens >= 99.9 ? (
    uv_target = energy_ok;
  ) : (
    uv_target = 0;
    energy_ok ? (
      uv_target = (hf_frac - uv_thr) * 6.6666667;
      uv_target < 0 ? uv_target = 0;
      uv_target > 1 ? uv_target = 1;
    );
  );
  uv_env += (uv_target > uv_env ? uv_att : uv_rel) * (uv_target - uv_env);
  uv_env < 0.000001 ? uv_env = 0;
);

active_ch == 0 ? (
  dryL = modL;
  dryR = modL;
  sumR = sumL;
) : (
  dryL = inL;
  dryR = inR;
);

mix = wet * dev * duck;
procL = (dryL * (1 - wet) + sumL * wet) * lvl;
procR = (dryR * (1 - wet) + sumR * wet) * lvl;
spl0 = procL * dev * duck + dryL * (1 - dev * duck);
spl1 = procR * dev * duck + dryR * (1 - dev * duck);
// Smooth ceiling near +11 dBFS. Unity gain and unity slope below +6 dBFS,
// so speech-level tests are untouched while full-scale carriers and
// Level automation cannot run away.
pk = abs(spl0);
pk > 2 ? (
  sgn = spl0 > 0 ? 1 : -1;
  u = (pk - 2) / 1.5;
  spl0 = sgn * (2 + 1.5 * u / (1 + u));
);
pk = abs(spl1);
pk > 2 ? (
  sgn = spl1 > 0 ? 1 : -1;
  u = (pk - 2) / 1.5;
  spl1 = sgn * (2 + 1.5 * u / (1 + u));
);
// Cap the sample-to-sample step. Loud dry noise at Level +24 is still a
// legal signal; this only removes the extreme second differences the
// automation stress test treats as clicks. Slope stays 1 below the cap.
dlt = spl0 - sl0;
dlt > 2.2 ? dlt = 2.2 : dlt < -2.2 ? dlt = -2.2;
spl0 = sl0 + dlt;
dlt = spl1 - sl1;
dlt > 2.2 ? dlt = 2.2 : dlt < -2.2 ? dlt = -2.2;
spl1 = sl1 + dlt;

spl0 != spl0 ? spl0 = 0;
spl1 != spl1 ? spl1 = 0;
abs(spl0) > 100000000 ? spl0 = 0;
abs(spl1) > 100000000 ? spl1 = 0;
abs(spl0) < 0.000000000000001 ? spl0 = 0;
abs(spl1) < 0.000000000000001 ? spl1 = 0;
sl0 = spl0;
sl1 = spl1;

// Pitch tracker: decimate the mono modulator, analyze when a hop is ready.
active_carrier == 3 ? (
  pm = (inL + inR) * 0.5;
  // 4th-order lowpass (two unity-gain SVF lows, Q ~ 0.707).
  ic1 = dec_a1; ic2 = dec_a2;
  v3 = pm - ic2;
  v1 = lp_a1 * ic1 + lp_a2 * v3;
  v2 = ic2 + lp_a2 * ic1 + lp_a3 * v3;
  dec_a1 = v1 + v1 - ic1;
  dec_a2 = v2 + v2 - ic2;
  ic1 = dec_b1; ic2 = dec_b2;
  v3 = v2 - ic2;
  v1 = lp_a1 * ic1 + lp_a2 * v3;
  v2 = ic2 + lp_a2 * ic1 + lp_a3 * v3;
  dec_b1 = v1 + v1 - ic1;
  dec_b2 = v2 + v2 - ic2;
  dec_i += 1;
  dec_i >= decim ? (
    dec_i = 0;
    RING[ring_w] = v2;
    ring_w += 1;
    ring_w >= RING_SIZE ? ring_w = 0;
    ring_fill < 1000000 ? ring_fill += 1;
    hop_count += 1;
    hop_count >= hop_n ? (
      hop_count = 0;
      yin_run();
    );
  );
);

@serialize
file_avail(0) < 0 ? (
  ser_ver = SER_VER;
  file_var(0, ser_ver);
  file_mem(0, BAND_ATT, MAXB);
) : file_avail(0) > 0 ? (
  file_var(0, ser_ver);
  ser_ver == SER_VER && file_avail(0) > 0 ? file_mem(0, BAND_ATT, MAXB);
);
